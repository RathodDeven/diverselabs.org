---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTAButton from '../components/CTAButton.astro';

const title = 'About Diverse Labs | AI Agency Behind ClickPe & ScaleUp';
const description = 'Meet the engineering-first team behind Diverse Labs, the AI agency building custom agents and automation for ClickPe (YC S23), ScaleUp, and more.';
const keywords = 'about Diverse Labs, AI agency, software development company, AI automation, custom AI systems, web app development';

const team = [
  {
    name: 'Deven Rathod',
    role: 'Engineering & Product',
    image: '/people/deven-rathod.webp',
    bio: '3× founder, 5+ years shipping production software & AI systems. Built products used by 20k+ users; software he built has helped teams raise $1M+.',
    links: {
      twitter: 'https://x.com/devenrathodrd',
      linkedin: 'https://www.linkedin.com/in/deven-rathod-475b39205/',
      github: 'https://github.com/RathodDeven/',
    },
  },
  {
    name: 'Priyam Haryani',
    role: 'Business Ops & Strategy',
    image: '/people/priyam-haryani.webp',
    bio: 'Business advisor and CRM specialist — aligns operations, admin systems, and growth so every engagement scales cleanly.',
    links: {
      linkedin: 'https://www.linkedin.com/in/priyam-h/',
    },
  },
  {
    name: 'Akanksha Bansal',
    role: 'GTM & Marketing',
    image: '/people/akanksha-bansal.webp',
    bio: 'Leads outreach, GTM, content strategy, and marketing — bringing sharp analytical thinking to every campaign.',
    links: {
      linkedin: 'https://www.linkedin.com/in/akanksha-bansal-20a8b8357/',
    },
  },
  {
    name: 'Daaud Saifi',
    role: 'VFX & AI Video',
    image: '/people/daaud-saifi.webp',
    bio: 'Professional VFX artist with 5+ years in high-end film and AI video. His videos have earned millions of views worldwide.',
    links: {
      linkedin: 'https://www.linkedin.com/in/daaud-saifi/',
    },
  },
];

const principles = [
  {
    num: '(01)',
    title: 'Outcome first',
    desc: 'Every automation must move a measurable metric: response time, conversion, cost per task, or throughput.',
  },
  {
    num: '(02)',
    title: 'No rip-and-replace',
    desc: 'Your CRM, e-commerce stack, and databases stay. We layer intelligence on top without disruption.',
  },
  {
    num: '(03)',
    title: 'Full control',
    desc: 'Fully automated, human-in-the-loop, or hybrid — you decide what runs on its own and what needs approval.',
  },
  {
    num: '(04)',
    title: 'Transparent systems',
    desc: 'Clear logs, clear prompts, clear governance. You always know what the AI did and why.',
  },
];

const steps = [
  {
    title: 'Discovery & Scoping',
    desc: 'We map your workflows, surface the highest-value opportunities, and define the exact system to build — in writing, before any code.',
  },
  {
    title: 'Architecture & Design',
    desc: 'Data flows, integration points, and approval logic locked down. You sign off on the design before development begins.',
  },
  {
    title: 'Build & Integrate',
    desc: 'Full build with weekly check-ins, delivered into your existing stack. Zero disruption to live operations.',
  },
  {
    title: 'Test & Refine',
    desc: 'Acceptance testing, edge cases, and team training. We don\'t hand off until you\'re confident it works.',
  },
  {
    title: 'Go Live & Support',
    desc: 'Live deployment, monitoring, and ongoing support. Most systems produce results within six weeks of kickoff.',
  },
];
---

<BaseLayout title={title} description={description} keywords={keywords}>

  <!-- ═══════════════ HERO ═══════════════ -->
  <section class="page-section-tight" style="padding-top: clamp(8rem, 16vh, 11rem)">
    <div class="container">
      <p class="label mb-6" data-reveal>About Diverse Labs</p>
      <h1 class="display-hero" data-split style="font-size: clamp(2.8rem, 7.5vw, 6.5rem)">
        Automation teams<br /><span class="text-outline">actually trust.</span>
      </h1>
      <div class="mt-8 max-w-xl" data-reveal data-reveal-delay="0.35">
        <p class="hero-sub">
          We design AI systems and production software that cut operating cost,
          increase speed, and integrate cleanly with your existing stack.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══════════════ BELIEF (scrubbed statement) ═══════════════ -->
  <section class="page-section line-grid">
    <div class="container">
      <p class="label mb-8" data-reveal>Our belief</p>
      <p class="scrub-statement" data-scrub-text style="max-width: 28ch">
        Your team carries the judgment and relationships no AI can replicate.
        The companies pulling ahead aren't cutting people — they're equipping
        them with systems that absorb the repetitive work.
      </p>

      <div class="principle-grid cols-4" data-reveal-group>
        {principles.map((p) => (
          <article class="principle-card">
            <span class="principle-glow" aria-hidden="true"></span>
            <span class="principle-num mono-num">{p.num}</span>
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════ PROCESS ═══════════════ -->
  <section class="page-section">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 lg:gap-20 items-start">
        <div class="lg:sticky lg:top-32">
          <p class="label mb-4" data-reveal>How we work</p>
          <h2 data-split>From discovery to live in weeks</h2>

          <div class="gantt" data-reveal data-reveal-delay="0.2" aria-hidden="true">
            <div class="gantt-weeks">
              <span>W1</span><span>W2</span><span>W3</span><span>W4</span><span>W5</span><span>W6</span>
            </div>
            <div class="gantt-row"><span class="gantt-lbl">Discover</span><span class="gantt-bar" style="--s:0; --e:1"></span></div>
            <div class="gantt-row"><span class="gantt-lbl">Design</span><span class="gantt-bar" style="--s:1; --e:2"></span></div>
            <div class="gantt-row"><span class="gantt-lbl">Build</span><span class="gantt-bar" style="--s:2; --e:4.5"></span></div>
            <div class="gantt-row"><span class="gantt-lbl">Test</span><span class="gantt-bar" style="--s:4; --e:5"></span></div>
            <div class="gantt-row"><span class="gantt-lbl">Live</span><span class="gantt-bar gantt-bar-live" style="--s:5; --e:6"></span></div>
          </div>

          <div class="mt-8" data-reveal data-reveal-delay="0.3">
            <a href="https://cal.com/diverselabs/30min" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
              Start with a call
            </a>
          </div>
        </div>

        <div class="process-wrap" data-process>
          <div class="process-rail" aria-hidden="true">
            <div class="process-rail-fill" data-process-line></div>
          </div>
          {steps.map((step, i) => (
            <div class="process-step">
              <div class="process-dot mono-num">{String(i + 1).padStart(2, '0')}</div>
              <div class="process-content">
                <h3>{step.title}</h3>
                <p>{step.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ TEAM ═══════════════ -->
  <section class="page-section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="label mb-4">The team</p>
          <h2>The people behind the work</h2>
        </div>
        <span class="head-side mono-num">(04)</span>
      </div>

      <div class="team-grid" data-reveal-group>
        {team.map((member) => (
          <article class="team-card">
            <div class="team-photo">
              <img
                src={member.image}
                alt={member.name}
                width="480"
                height="528"
                loading="lazy"
                decoding="async"
              />
              <div class="team-id">
                <h3>{member.name}</h3>
                <span class="team-role">{member.role}</span>
              </div>
            </div>
            <div class="team-body">
              <p>{member.bio}</p>
              <div class="team-social">
                {member.links.twitter && (
                  <a href={member.links.twitter} target="_blank" rel="noopener noreferrer" aria-label={`${member.name} on X`}>
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.74l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                    </svg>
                  </a>
                )}
                {member.links.linkedin && (
                  <a href={member.links.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`${member.name} on LinkedIn`}>
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                  </a>
                )}
                {member.links.github && (
                  <a href={member.links.github} target="_blank" rel="noopener noreferrer" aria-label={`${member.name} on GitHub`}>
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════ CTA ═══════════════ -->
  <section class="page-section-tight pb-24">
    <div class="container">
      <div class="cta-panel" data-reveal>
        <div class="relative z-10">
          <h2 class="cta-title">Let's build together.</h2>
          <p class="cta-sub">
            We'll show you exactly what to automate first — and what it will be worth.
          </p>
          <CTAButton href="https://cal.com/diverselabs/30min">Schedule a Discovery Call</CTAButton>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
