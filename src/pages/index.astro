<script>
  // Framed showcase loops: play only while on screen
  function bindLoopVideos() {
    const vids = document.querySelectorAll<HTMLVideoElement>('[data-loop-video]');
    if (!vids.length) return;
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) v.play().catch(() => undefined);
          else v.pause();
        });
      },
      { rootMargin: '80px 0px' }
    );
    vids.forEach((v) => {
      if (!v.dataset.bound) {
        v.dataset.bound = '1';
        io.observe(v);
      }
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bindLoopVideos);
  else bindLoopVideos();
  document.addEventListener('astro:page-load', bindLoopVideos);
</script>

