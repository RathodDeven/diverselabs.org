---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroParticles from '../components/HeroParticles.astro';

const title = 'Diverse Labs | AI Agents & Automation for Growing Businesses';
const description = 'AI automation systems, software products, and AI video production for teams that want faster execution with measurable outcomes.';

const services = [
  {
    num: '01',
    title: 'AI Chat & Support Agents',
    desc: 'Conversational agents trained on your knowledge base that resolve queries, qualify leads, and escalate intelligently.',
    chips: ['Multi-turn memory', 'CRM sync', 'Smart escalation'],
    mockup: 'chat',
  },
  {
    num: '02',
    title: 'Lead Gen & CRM Automation',
    desc: 'Pipelines that capture, score, and route leads — then trigger follow-ups without anyone lifting a finger.',
    chips: ['Lead scoring', 'Auto follow-ups', 'Pipeline sync'],
    mockup: 'pipeline',
  },
  {
    num: '03',
    title: 'Semantic Search & Doc Intelligence',
    desc: 'RAG-powered search across your documents, PDFs, and databases. Answers in seconds, not hours.',
    chips: ['Full RAG stack', 'PDF parsing', 'Instant retrieval'],
    mockup: 'search',
  },
  {
    num: '04',
    title: 'AI Video & Creative Production',
    desc: 'Photorealistic AI video ads and UGC content with natural voices — produced at a fraction of studio cost.',
    chips: ['Realistic avatars', 'Brand scripts', 'Fast turnaround'],
    mockup: 'video',
  },
  {
    num: '05',
    title: 'Data Query & Analysis',
    desc: 'Ask your database questions in plain English. Get structured answers, live charts, and alerts back.',
    chips: ['NL-to-SQL', 'Auto dashboards', 'Anomaly alerts'],
    mockup: 'terminal',
  },
  {
    num: '06',
    title: 'Predictive Analytics & ML',
    desc: 'Custom models trained on your data to forecast demand, churn, or performance — embedded in your workflow.',
    chips: ['Custom models', 'Forecasting', 'Live monitoring'],
    mockup: 'chart',
  },
];

const allClients = [
  { name: 'ClickPe',                   logo: '/companies/clickpe.jpeg',          href: 'https://clickpe.ai/' },
  { name: 'ScaleUp Inc',               logo: '/companies/scaleup.jpeg',          href: 'https://scaleupinc.com/' },
  { name: 'AD360',                     logo: '/companies/ad360.jpeg',            href: 'https://ad360.in/' },
  { name: 'DigitalKalakari',           logo: '/companies/digitalkalakari.jpeg',  href: 'https://digitalkalakari.com/' },
  { name: 'Mezh Studio',               logo: '/companies/mezh_studio.jpeg',      href: 'https://www.instagram.com/mezh.studio/' },
  { name: 'BloomersTV',                logo: '/companies/bloomerstv.jpeg',       href: 'https://bloomers.tv/' },
  { name: 'Hand Protocol',             logo: '/companies/handprotocol.jpeg',     href: 'https://handprotocol.org/' },
  { name: 'DANZ NOW',                  logo: '/companies/danz.jpeg',             href: 'https://danz.now/' },
  { name: 'Interality',                logo: '/companies/interality.jpeg',       href: 'https://www.instagram.com/interality/' },
  { name: 'Paiso',                     logo: '/companies/paiso.jpeg',            href: 'https://paiso.xyz/' },
  { name: 'Vikram Enterprise',         logo: '/companies/vikram_enterprise.jpeg' },
  { name: 'Vashi Integrated Solutions',logo: '/companies/vashi.jpeg' },
  { name: 'Landboard',                 logo: '/companies/landboard.jpeg' },
  { name: 'Celo',                      logo: '/companies/celo.jpeg' },
  { name: 'Lens',                      logo: '/companies/lens.jpeg' },
  { name: 'Livepeer',                  logo: '/companies/livepeer.jpeg' },
];

const halfway = Math.ceil(allClients.length / 2);
const logoRowOne = allClients.slice(0, halfway);
const logoRowTwo = allClients.slice(halfway);

const homeProjects = [
  {
    name: 'NudgeFlow · ClickPe (YC S23)',
    image: '/work/nudgeflow.webp',
    href: 'https://drive.google.com/file/d/10uMQ51a0u_D_SWAobehndmie-6HTT-lZ/view',
    tags: ['AI system', 'Voice agent'],
    description: 'WhatsApp + voice agents that classify leads and sync outcomes automatically.',
  },
  {
    name: 'AI Creatives',
    image: '/work/ai-creatives-thumbnail.png',
    href: '/work/ai-creatives',
    tags: ['AI video', 'UGC'],
    description: 'Photorealistic AI video ads and UGC content, produced for brands at speed.',
  },
  {
    name: 'BloomersTV',
    image: '/work/bloomerstv.webp',
    href: 'https://bloomers.tv/',
    tags: ['Web app', 'Blockchain'],
    description: 'A live streaming platform built on the Lens ecosystem for creators.',
  },
  {
    name: 'Paiso',
    image: '/work/paiso.webp',
    href: 'https://paiso.xyz/',
    tags: ['Mobile app', 'Fintech'],
    description: 'Consumer fintech app live on the Play Store — fast cash access and rewards.',
  },
  {
    name: 'DANZ NOW',
    image: '/work/danz-now.webp',
    href: 'https://danz.now/',
    tags: ['Mobile app'],
    description: 'A movement platform rewarding users for dancing and hosting events.',
  },
  {
    name: 'Hand Protocol',
    image: '/work/hand-protocol.webp',
    href: 'https://handprotocol.org/',
    tags: ['Web app', 'Blockchain'],
    description: 'Connecting public goods projects with donors through a streamlined experience.',
  },
];

const tapeWords = ['AI Agents', 'Automation', 'AI Video', 'Web & Mobile', 'Data & ML'];

const faqs = [
  {
    question: 'What is an AI agent and how is it different from a regular chatbot?',
    answer: 'A chatbot follows scripted rules and responds to predefined inputs. An AI agent understands context, reasons through multi-step problems, executes actions across tools and APIs, and completes goals autonomously. Think of a chatbot as a vending machine and an AI agent as a skilled employee who never sleeps.',
  },
  {
    question: 'How does Diverse Labs customize AI systems for our specific business?',
    answer: 'We start with a free discovery session where we map your exact workflows, data sources, and business rules. From there, we design an AI solution built specifically for your stack, not a generic template. The agent knows your products, your tone, your processes, and connects to your existing tools from day one.',
  },
  {
    question: 'Do you build regular software too, or only AI?',
    answer: 'Both. Our team builds production-grade web applications, mobile apps (iOS and Android), desktop software, and AI-powered products from the ground up. We have shipped real products used by thousands of people across fintech, creator platforms, and enterprise tools.',
  },
  {
    question: 'What is human-in-the-loop automation and can we control it?',
    answer: 'Human-in-the-loop means a human reviews and approves specific actions before the AI proceeds. We offer fully automated, human-in-the-loop, and hybrid designs; you decide which stages require human approval and which run automatically. You have total control.',
  },
  {
    question: 'Will we need to replace our existing tools and systems?',
    answer: 'No. We build on top of what you already have. Whether you use Salesforce, HubSpot, Shopify, custom databases, or anything else, our AI layer integrates into your existing stack. No rip-and-replace, no disruption to current operations.',
  },
  {
    question: 'How long does it take to build and deploy an AI system?',
    answer: 'A focused AI agent typically takes 2-4 weeks from discovery to live deployment. A multi-agent system with deep CRM integrations can take 8-12 weeks. We provide a precise timeline after the initial discovery call, with clear milestones at each stage.',
  },
  {
    question: 'What industries and business types do you work with?',
    answer: 'We work primarily with e-commerce, fintech, SaaS, and professional services companies with high-volume repetitive workflows. Company size ranges from funded startups to established enterprises.',
  },
  {
    question: 'What does a typical engagement look like?',
    answer: 'We start with a discovery session to scope the opportunity and propose a clear implementation plan with milestones. After delivery, we monitor performance and iterate weekly. Most clients see measurable results within the first 30 days of deployment.',
  },
];
---

<BaseLayout title={title} description={description}>

  <!-- ═══════════════ HERO ═══════════════ -->
  <section class="hero">
    <div class="hero-grid-bg" aria-hidden="true"></div>
    <div class="hero-aurora" aria-hidden="true"></div>
    <HeroParticles />

    <div class="container relative z-10">
      <div class="mb-7" data-reveal>
        <span class="badge">
          <span class="badge-dot" aria-hidden="true"></span>
          Currently taking new projects
        </span>
      </div>

      <h1 class="display-hero" data-split data-split-delay="0.15" aria-label="Your AI Tech Partner.">
        Your AI<br /><span class="text-outline">Tech Partner.</span>
      </h1>

      <div class="mt-8 flex flex-col md:flex-row md:items-end md:justify-between gap-8">
        <p class="hero-sub" data-reveal data-reveal-delay="0.45">
          We design and ship custom AI agents, automation, and production software —
          systems that do real work for your team.
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3" data-reveal data-reveal-delay="0.55">
          <a href="https://cal.com/diverselabs/30min"
             target="_blank"
             rel="noopener noreferrer"
             class="btn btn-primary btn-lg magnetic">
            Book a Discovery Call
            <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
          <a href="#work" class="btn btn-secondary btn-lg">
            Explore the work
          </a>
        </div>
      </div>

      <div class="hero-stats" data-reveal data-reveal-delay="0.7">
        <div class="hero-stat">
          <div class="hero-stat-num"><span data-count="10" data-suffix="+">10+</span></div>
          <div class="hero-stat-label">AI agents in production</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-num"><span data-count="15" data-suffix="+">15+</span></div>
          <div class="hero-stat-label">Products shipped</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-num">3–5×</div>
          <div class="hero-stat-label">Avg. ROI in year one</div>
        </div>
      </div>
    </div>

    <div class="scroll-cue" aria-hidden="true">
      <span>Scroll</span>
      <span class="scroll-cue-line"></span>
    </div>
  </section>

  <!-- ═══════════════ TAPE MARQUEE ═══════════════ -->
  <section class="tape" data-marquee data-speed="1" aria-hidden="true">
    <div class="tape-track" data-marquee-track>
      {[0, 1].map(() => (
        <div class="tape-row">
          {tapeWords.map((word, i) => (
            <>
              <span class={`tape-item${i % 2 === 1 ? ' outline' : ''}`}>{word}</span>
              <span class="tape-star">✦</span>
            </>
          ))}
        </div>
      ))}
    </div>
  </section>

  <!-- ═══════════════ TRUSTED BY ═══════════════ -->
  <section class="page-section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="label mb-4">Trusted by</p>
          <h2><span data-count="15" data-suffix="+">15+</span> teams we've shipped for</h2>
        </div>
        <span class="head-side">Startups → Enterprise</span>
      </div>
    </div>

    <div class="logo-tape" data-marquee data-speed="0.55" data-skew="false" aria-label="Clients and partners">
      <div class="logo-tape-track" data-marquee-track>
        {[0, 1].map(() => (
          <div class="logo-tape-row">
            {logoRowOne.map((client) =>
              client.href ? (
                <a class="logo-card" href={client.href} target="_blank" rel="nofollow noopener noreferrer" aria-label={`Visit ${client.name} website`}>
                  <img src={client.logo} alt={`${client.name} logo`} loading="lazy" decoding="async" />
                  <span class="logo-arrow" aria-hidden="true">↗</span>
                </a>
              ) : (
                <div class="logo-card">
                  <img src={client.logo} alt={`${client.name} logo`} loading="lazy" decoding="async" />
                </div>
              )
            )}
          </div>
        ))}
      </div>
    </div>

    <div class="logo-tape" data-marquee data-speed="0.55" data-skew="false" data-direction="right" aria-hidden="true">
      <div class="logo-tape-track" data-marquee-track>
        {[0, 1].map(() => (
          <div class="logo-tape-row">
            {logoRowTwo.map((client) =>
              client.href ? (
                <a class="logo-card" href={client.href} target="_blank" rel="nofollow noopener noreferrer" tabindex="-1" aria-label={`Visit ${client.name} website`}>
                  <img src={client.logo} alt={`${client.name} logo`} loading="lazy" decoding="async" />
                  <span class="logo-arrow" aria-hidden="true">↗</span>
                </a>
              ) : (
                <div class="logo-card">
                  <img src={client.logo} alt={`${client.name} logo`} loading="lazy" decoding="async" />
                </div>
              )
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════ SERVICES (stacking cards) ═══════════════ -->
  <section id="capabilities" class="page-section line-grid">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="label mb-4">What we build</p>
          <h2>AI systems that do real work</h2>
        </div>
        <span class="head-side mono-num">(06) Capabilities</span>
      </div>

      <div class="stack" data-stack>
        {services.map((s) => (
          <div class="stack-card">
            <div class="stack-card-inner">
              <div class="stack-copy">
                <span class="stack-idx mono-num">{s.num} / 06</span>
                <h3 class="stack-title">{s.title}</h3>
                <p class="stack-desc">{s.desc}</p>
                <div class="stack-chips">
                  {s.chips.map((chip) => <span class="chip">{chip}</span>)}
                </div>
                <a href="https://cal.com/diverselabs/30min" target="_blank" rel="noopener noreferrer" class="stack-link">
                  <span class="stack-link-arrow" aria-hidden="true">→</span>
                  Discuss this system
                </a>
              </div>

              <div class="stack-visual" aria-hidden="true">
                <div class="svc-mockup">
                  {s.mockup === 'chat' && (
                    <div>
                      <div class="sm-bar">
                        <span class="sm-dot"></span><span class="sm-dot"></span><span class="sm-dot"></span>
                        <span class="sm-bar-title">Support Agent</span>
                      </div>
                      <div class="sm-chat">
                        <div class="sm-bubble sm-user" style="animation-delay:0.4s">Hi, where is my order?</div>
                        <div class="sm-typing" style="animation-delay:0.9s"><span></span><span></span><span></span></div>
                        <div class="sm-bubble sm-bot" style="animation-delay:1.6s">Your order #4821 ships tomorrow. I've sent tracking to your email.</div>
                      </div>
                    </div>
                  )}
                  {s.mockup === 'pipeline' && (
                    <div>
                      <div class="sm-bar">
                        <span class="sm-dot"></span><span class="sm-dot"></span><span class="sm-dot"></span>
                        <span class="sm-bar-title">Lead Pipeline</span>
                      </div>
                      <div class="sm-pipeline">
                        <div class="sm-col">
                          <div class="sm-col-hdr">New</div>
                          <div class="sm-card" style="animation-delay:0.3s">Acme Corp</div>
                          <div class="sm-card" style="animation-delay:0.5s">TechStart</div>
                        </div>
                        <div class="sm-col">
                          <div class="sm-col-hdr">Qualified</div>
                          <div class="sm-card sm-card-hot" style="animation-delay:0.7s">Globex Inc</div>
                        </div>
                        <div class="sm-col">
                          <div class="sm-col-hdr">Closing</div>
                          <div class="sm-card" style="animation-delay:0.9s">Initech</div>
                        </div>
                      </div>
                    </div>
                  )}
                  {s.mockup === 'search' && (
                    <div>
                      <div class="sm-bar">
                        <span class="sm-dot"></span><span class="sm-dot"></span><span class="sm-dot"></span>
                        <div class="sm-search-bar-wrap">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                          <span>refund policy Q3</span>
                        </div>
                      </div>
                      <div class="sm-imgrid">
                        <div class="sm-imgbox sm-imgbox-hl" style="animation-delay:0.3s"></div>
                        <div class="sm-imgbox" style="animation-delay:0.5s"></div>
                        <div class="sm-imgbox" style="animation-delay:0.7s"></div>
                        <div class="sm-imgbox" style="animation-delay:0.9s"></div>
                      </div>
                    </div>
                  )}
                  {s.mockup === 'video' && (
                    <div>
                      <div class="sm-bar">
                        <span class="sm-dot"></span><span class="sm-dot"></span><span class="sm-dot"></span>
                        <span class="sm-bar-title">AI Creative Studio</span>
                      </div>
                      <div class="sm-player">
                        <div class="sm-video-frame">
                          <div class="sm-play-btn"><div class="sm-play-icon"></div></div>
                        </div>
                        <div class="sm-progress-bar"><div class="sm-progress-fill"></div></div>
                      </div>
                    </div>
                  )}
                  {s.mockup === 'terminal' && (
                    <div>
                      <div class="sm-bar">
                        <span class="sm-dot"></span><span class="sm-dot"></span><span class="sm-dot"></span>
                        <span class="sm-bar-title">Query Engine</span>
                      </div>
                      <div class="sm-terminal">
                        <div class="sm-cmd" style="animation-delay:0.3s">$ ask "revenue by region last 90d"</div>
                        <div class="sm-out" style="animation-delay:0.9s">Running SQL… 1,240ms</div>
                        <div class="sm-out" style="animation-delay:1.4s">North: $84k · South: $61k · West: $102k</div>
                        <div class="sm-caret" style="animation-delay:1.9s">▌</div>
                      </div>
                    </div>
                  )}
                  {s.mockup === 'chart' && (
                    <div>
                      <div class="sm-bar">
                        <span class="sm-dot"></span><span class="sm-dot"></span><span class="sm-dot"></span>
                        <span class="sm-bar-title">Forecast Model</span>
                      </div>
                      <div class="sm-chart">
                        <div class="sm-bar-v" style="height:38px; animation-delay:0.3s"></div>
                        <div class="sm-bar-v" style="height:58px; animation-delay:0.45s"></div>
                        <div class="sm-bar-v" style="height:48px; animation-delay:0.6s"></div>
                        <div class="sm-bar-v sm-bar-v-hi" style="height:80px; animation-delay:0.75s"></div>
                        <div class="sm-bar-v" style="height:66px; animation-delay:0.9s"></div>
                        <div class="sm-bar-v sm-bar-v-hi" style="height:94px; animation-delay:1.05s"></div>
                      </div>
                    </div>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════ WORK REEL (pinned horizontal) ═══════════════ -->
  <section id="work" class="reel-section" data-reel aria-label="Selected work">
    <div class="reel-viewport">
      <div class="reel-head container">
        <div>
          <p class="label mb-4">Selected work</p>
          <h2>Shipped for real teams</h2>
        </div>
        <span class="reel-count mono-num">
          <span class="reel-current" data-reel-counter>01</span> / {String(homeProjects.length).padStart(2, '0')}
        </span>
      </div>

      <div class="reel-track" data-reel-track>
        {homeProjects.map((project) => (
          <article class="reel-card">
            <a
              href={project.href}
              target={project.href.startsWith('http') ? '_blank' : undefined}
              rel={project.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              aria-label={`Open ${project.name}`}
            >
              <div class="reel-media">
                <img
                  src={project.image}
                  alt={`${project.name} preview`}
                  width="800"
                  height="500"
                  loading="lazy"
                  decoding="async"
                />
                <span class="reel-open">Open <span aria-hidden="true">↗</span></span>
              </div>
              <div class="reel-meta">
                <h3>{project.name}</h3>
                <div class="reel-tags">
                  {project.tags.map((tag) => <span class="chip">{tag}</span>)}
                </div>
              </div>
              <p class="reel-desc">{project.description}</p>
            </a>
          </article>
        ))}
      </div>

      <div class="reel-progress container" aria-hidden="true">
        <div class="reel-progress-track">
          <div class="reel-progress-bar" data-reel-bar></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ PHILOSOPHY ═══════════════ -->
  <section class="page-section">
    <div class="container">
      <p class="label mb-8" data-reveal>Philosophy</p>
      <p class="scrub-statement" data-scrub-text>
        Repetitive work shouldn't consume your smartest people. We build AI that
        absorbs the routine — so your team drives the decisions that actually
        move the business.
      </p>

      <div class="principle-grid" data-reveal-group>
        <article class="principle-card">
          <span class="principle-glow" aria-hidden="true"></span>
          <span class="principle-num mono-num">(01)</span>
          <h3>Focus on what matters</h3>
          <p>Your team spends time on high-impact work, not repetitive ops.</p>
        </article>
        <article class="principle-card">
          <span class="principle-glow" aria-hidden="true"></span>
          <span class="principle-num mono-num">(02)</span>
          <h3>Control without black boxes</h3>
          <p>You choose what runs automatically and what needs human approval.</p>
        </article>
        <article class="principle-card">
          <span class="principle-glow" aria-hidden="true"></span>
          <span class="principle-num mono-num">(03)</span>
          <h3>Built for your workflow</h3>
          <p>Every system is custom to your data, stack, and business logic.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ═══════════════ FAQ ═══════════════ -->
  <section class="page-section">
    <div class="container" style="max-width: 56rem">
      <div class="section-head" data-reveal>
        <div>
          <p class="label mb-4">FAQ</p>
          <h2>Common questions</h2>
        </div>
        <span class="head-side mono-num">({String(faqs.length).padStart(2, '0')})</span>
      </div>

      <div class="faq-list acc-group" data-reveal-group>
        {faqs.map((faq, i) => (
          <div class={`faq-item acc-item${i === 0 ? ' open' : ''}`}>
            <button class="faq-head acc-head" aria-expanded={i === 0 ? 'true' : 'false'}>
              <span class="faq-idx mono-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="faq-q">{faq.question}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </button>
            <div class="faq-body">
              <div class="faq-body-inner">
                <p>{faq.answer}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════ CTA ═══════════════ -->
  <section class="page-section-tight pb-24">
    <div class="container">
      <div class="cta-panel" data-reveal>
        <div class="relative z-10">
          <p class="label no-rule mb-6 justify-center flex">Ready when you are</p>
          <h2 class="cta-title" data-split>Still doing repetitive<br />work by hand?</h2>
          <p class="cta-sub">Let's build an AI system that gives your team its time back.</p>
          <div class="flex flex-col sm:flex-row items-center gap-4 justify-center">
            <a href="https://cal.com/diverselabs/30min"
               target="_blank"
               rel="noopener noreferrer"
               class="btn btn-primary btn-lg magnetic">
              Book a Discovery Call
              <span class="btn-arrow" aria-hidden="true">→</span>
            </a>
            <a href="mailto:deven@diverselabs.org"
               class="footer-link text-sm">
              or email deven@diverselabs.org
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
