---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTAButton from '../components/CTAButton.astro';

const title = 'AI Automation Agency & Custom AI Agents | Diverse Labs';
const description =
  'Diverse Labs is an AI automation agency building custom AI agents, CRM and WhatsApp automation, and AI video ads for startups like ClickPe (YC S23).';
---

<BaseLayout title={title} description={description} hideBackdrop hideFooterCta>
  <!-- ═══════════════ HERO — instant clarity before the film ═══════════════ -->
  <section class="hero">
    <div class="hero-grid-bg" aria-hidden="true"></div>
    <div class="hero-aurora" aria-hidden="true"></div>

    <div class="container relative z-10">
      <div class="hero-layout">
        <div class="hero-copy">
          <h1 class="display-hero" data-split data-split-delay="0.15" aria-label="Your AI Tech Partner.">
            Your AI<br /><span class="text-outline">Tech Partner.</span>
          </h1>

          <p class="hero-sub mt-7" data-reveal data-reveal-delay="0.45">
            We're an AI automation agency. We design and ship custom AI agents,
            workflow automation, and production software that does real work
            for your team.
          </p>

          <div class="hero-cta-row mt-8" data-reveal data-reveal-delay="0.55">
            <CTAButton href="https://cal.com/diverselabs/30min">Book a Discovery Call</CTAButton>
            <a href="/work" class="btn btn-secondary btn-lg">
              Explore the work
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ THE FILM ═══════════════ -->
  <div id="film" class="film">
    <div id="film-track" class="film-track">
      <div class="film-stage">
        <!-- Scene 8 CTA panel — lives BEHIND the canvas; the gate opens onto it -->
        <div class="film-panel">
          <p class="panel-kicker">See what to automate first, and what it's worth.</p>
          <a
            class="panel-build"
            href="https://cal.com/diverselabs/30min"
            target="_blank"
            rel="noopener noreferrer">LET'S BUILD</a
          >
          <div class="panel-row">
            <a
              class="btn btn-primary"
              href="https://cal.com/diverselabs/30min"
              target="_blank"
              rel="noopener noreferrer">Book a call</a
            >
            <a class="panel-link" href="/services">Services →</a>
            <a class="panel-link" href="/work">Work →</a>
            <a class="panel-link" href="/about">About →</a>
          </div>
        </div>

        <canvas id="film-canvas" aria-hidden="true"></canvas>

        <!-- DOM copy layer — real text, above the canvas -->
        <div class="film-copy" aria-hidden="false">
          <p class="film-hint" data-cap="grind" data-in="0" data-out="0.10">scroll</p>

          <div class="film-proof" data-cap="proof-nudgeflow" data-in="0.3" data-out="1">
            <p class="proof-tag">
              NudgeFlow · ClickPe (YC S23)
              <a href="/work/clickpe-nudgeflow-whatsapp-voice-ai-agent">case study ↗</a>
            </p>
          </div>

          <div class="film-proof" data-cap="proof-approved" data-in="0.32" data-out="0.85">
            <p class="proof-tag">
              CRM follow-up agent · ScaleUp
              <a href="/work/scaleup-zoho-crm-follow-up-agent">case study ↗</a>
            </p>
          </div>

          <!-- Scene 6: AI creatives — real published ads on phone cards -->
          <div id="film-phones" class="film-phones" aria-hidden="true">
            {['c1', 'c2', 'c3'].map((n) => (
              <div class="phone">
                <video
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  poster={`/film/creatives/${n}.webp`}
                  src={`/film/creatives/${n}.mp4`}
                ></video>
              </div>
            ))}
          </div>

          <div class="film-proof" data-cap="creatives" data-in="0.45" data-out="0.85">
            <p class="proof-tag">
              AI Creatives — ads &amp; UGC we produce
              <a href="/work/ai-creatives">see the work ↗</a>
            </p>
          </div>

          <!-- Scene 6 backdrop: client logos drifting in rows toward top-left -->
          <div id="film-logos" class="film-logos" aria-hidden="true">
            {[
              [
                ['clickpe', 'ClickPe'], ['scaleup', 'ScaleUp'], ['ad360', 'AD360'],
                ['digitalkalakari', 'DigitalKalakari'], ['mezh_studio', 'Mezh Studio'], ['bloomerstv', 'BloomersTV'],
              ],
              [
                ['handprotocol', 'Hand Protocol'], ['danz', 'DANZ NOW'], ['interality', 'Interality'],
                ['paiso', 'Paiso'], ['vikram_enterprise', 'Vikram Enterprise'],
              ],
              [
                ['vashi', 'Vashi Integrated'], ['landboard', 'Landboard'], ['celo', 'Celo'],
                ['lens', 'Lens'], ['livepeer', 'Livepeer'],
              ],
            ].map((row) => (
              <div class="logo-row">
                {[...row, ...row].map(([file, name]) => (
                  <span class="logo-chip">
                    <img src={`/companies/${file}.jpeg`} alt={name} width="48" height="48" loading="lazy" />
                  </span>
                ))}
              </div>
            ))}
          </div>

          <!-- Scene 6: odometer stats (digit strips built by the scene) -->
          <div id="film-odo" class="film-odo">
            <div class="odo-row">
              <span class="odo-val" data-odo-val="10+"></span>
              <span class="odo-label">agents in production</span>
            </div>
            <div class="odo-row">
              <span class="odo-val" data-odo-val="20k+"></span>
              <span class="odo-label">users reached</span>
            </div>
            <div class="odo-row">
              <span class="odo-val" data-odo-val="15+"></span>
              <span class="odo-label">teams served</span>
            </div>
          </div>

          <!-- Scene 8: the LinkedIn recommendation, spoken word by word -->
          <div id="film-voices" class="film-voices">
            <div class="voices-head">
              <span class="voices-eyebrow">In their words</span>
              <a
                class="voices-badge"
                href="https://www.linkedin.com/in/deven-rathod-475b39205"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="View this recommendation on LinkedIn"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="14" height="14">
                  <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" />
                </svg>
                Recommended on LinkedIn ↗
              </a>
            </div>
            <blockquote class="vq">
              …strong technical execution with an operator's mindset — making
              Diverse Labs a reliable partner for turning complex workflows
              into tools we actually use.
            </blockquote>
            <div class="voices-by">
              <img src="/people/marcos-buelvas.webp" alt="Marcos Buelvas" width="52" height="52" loading="lazy" />
              <span class="voices-meta">
                <span class="voices-name">Marcos Buelvas</span>
                <span class="voices-role">Global Operations Consulting · ScaleUp · Client</span>
              </span>
            </div>
          </div>

          <!-- Scene 9: the belief line (words gain weight, not opacity) -->
          <p class="film-turn">Your people carry the judgment. We build everything else.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- ═══════════════ EDITORIAL FALLBACK (no JS / reduced motion / no WebGL) ═══════════════ -->
  <section class="film-fallback page-section" aria-label="Diverse Labs introduction">
    <div class="container">
      <p class="label">Diverse Labs</p>
      <h2 class="display-hero">Machines should do the machine work.</h2>
      <p class="hero-sub">
        Your best people are doing machine work: follow-ups, re-typing, chasing
        status. We build AI agents that absorb it, layered on the stack you
        already run. Drafted by machines. Approved by humans.
      </p>
      <div class="fb-beats">
        <p><strong>NudgeFlow — ClickPe (YC S23).</strong> WhatsApp + voice agents that catch leads before they cool.</p>
        <p><strong>CRM follow-up agent — ScaleUp.</strong> Drafts every follow-up; a human approves every send.</p>
        <p><strong>AI Creatives.</strong> Published AI video ads and UGC, produced end to end.</p>
        <p><strong>10+ agents in production · 20k+ users reached · 15+ teams served.</strong></p>
        <p><strong>"…strong technical execution with an operator's mindset."</strong> — Marcos Buelvas, ScaleUp, recommended on LinkedIn.</p>
        <p><strong>Your people carry the judgment. We build everything else.</strong></p>
      </div>
      <div class="panel-row">
        <a
          class="btn btn-primary"
          href="https://cal.com/diverselabs/30min"
          target="_blank"
          rel="noopener noreferrer">Book a call</a
        >
        <a class="panel-link" href="/services">Services →</a>
        <a class="panel-link" href="/work">Work →</a>
        <a class="panel-link" href="/about">About →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/film/index';
</script>

