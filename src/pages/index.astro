  <script>
    function initShowcase() {
      // Facade: nothing loads until the visitor hits play (keeps the page light).
      document.querySelectorAll<HTMLElement>('[data-showcase]').forEach((card) => {
        if (card.dataset.bound) return;
        card.dataset.bound = 'true';
        const media = card.querySelector<HTMLElement>('.showcase-media');
        const src = card.dataset.src;
        if (!media || !src) return;
        media.addEventListener('click', () => {
          if (card.classList.contains('is-playing')) return;
          const iframe = document.createElement('iframe');
          iframe.className = 'showcase-iframe';
          iframe.src = src;
          iframe.title = card.querySelector('h3')?.textContent || 'Explainer video';
          iframe.setAttribute('allowfullscreen', '');
          iframe.setAttribute('loading', 'lazy');
          media.appendChild(iframe);
          card.classList.add('is-playing');
        });
      });

      // Hero showreel: pause the animation loop while it's off-screen (CPU saving).
      const reel = document.querySelector<HTMLElement>('[data-hero-reel]');
      const frame = reel?.querySelector('iframe');
      if (reel && frame && !reel.dataset.bound) {
        reel.dataset.bound = 'true';
        const io = new IntersectionObserver((entries) => {
          const visible = entries[0].isIntersecting;
          frame.contentWindow?.postMessage(visible ? 'dl-play' : 'dl-pause', location.origin);
        }, { threshold: 0, rootMargin: '200px 0px' });
        io.observe(reel);
      }
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initShowcase);
    else initShowcase();
    document.addEventListener('astro:page-load', initShowcase);
  </script>

