---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Contact - Diverse Labs';
const description = "Let's talk about automating your business.";

const quickFaqs = [
  {
    q: 'How long does implementation take?',
    a: 'Simple agents: 2-4 weeks. Complex integrations: 6-8 weeks. You get a precise timeline after discovery.',
  },
  {
    q: 'Do you work with our existing tools?',
    a: 'Yes — CRM, e-commerce, databases, whatever you already run. No rip-and-replace.',
  },
  {
    q: "What's the cost?",
    a: 'Custom pricing per scope. Clients typically see 3-5× the implementation cost back within year one.',
  },
  {
    q: 'Do you maintain it after launch?',
    a: 'Absolutely. We monitor, optimize, and support your team — think of us as your AI ops team.',
  },
];
---

<BaseLayout title={title} description={description}>

  <!-- ═══════════════ HERO ═══════════════ -->
  <section class="page-section-tight" style="padding-top: clamp(8rem, 16vh, 11rem)">
    <div class="container">
      <p class="label mb-6" data-reveal>Contact</p>
      <h1 class="display-hero" data-split style="font-size: clamp(2.8rem, 7.5vw, 6.5rem)">
        Let's <span class="text-outline">talk.</span>
      </h1>
      <div class="mt-8 max-w-xl" data-reveal data-reveal-delay="0.35">
        <p class="hero-sub">
          Tell us about your business. We'll show you what we can automate —
          30 minutes, no pitch.
        </p>
      </div>
      <div class="mt-10 flex flex-col sm:flex-row items-start sm:items-center gap-4" data-reveal data-reveal-delay="0.45">
        <a href="https://cal.com/diverselabs/30min" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg magnetic">
          Schedule a Discovery Call
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
        <a href="mailto:deven@diverselabs.org" class="footer-link">deven@diverselabs.org</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════ STATS ═══════════════ -->
  <section class="page-section-tight">
    <div class="container">
      <div class="hero-stats" style="margin-top: 0" data-reveal>
        <div class="hero-stat">
          <div class="hero-stat-num"><span data-count="10" data-suffix="+">10+</span></div>
          <div class="hero-stat-label">Live AI agents in production</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-num"><span data-count="100" data-suffix="%">100%</span></div>
          <div class="hero-stat-label">Integration success rate</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-num">3–5×</div>
          <div class="hero-stat-label">Average ROI in year one</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ QUICK FAQ ═══════════════ -->
  <section class="page-section">
    <div class="container" style="max-width: 56rem">
      <div class="section-head" data-reveal>
        <div>
          <p class="label mb-4">Before you book</p>
          <h2>Common questions</h2>
        </div>
      </div>

      <div class="faq-list acc-group" data-reveal-group>
        {quickFaqs.map((faq, i) => (
          <div class={`faq-item acc-item${i === 0 ? ' open' : ''}`}>
            <button class="faq-head acc-head" aria-expanded={i === 0 ? 'true' : 'false'}>
              <span class="faq-idx mono-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="faq-q">{faq.q}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </button>
            <div class="faq-body">
              <div class="faq-body-inner">
                <p>{faq.a}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════ CTA ═══════════════ -->
  <section class="page-section-tight pb-24">
    <div class="container">
      <div class="cta-panel" data-reveal>
        <div class="relative z-10">
          <h2 class="cta-title">Ready to free up your team?</h2>
          <p class="cta-sub">No obligations. Just ideas.</p>
          <a href="https://cal.com/diverselabs/30min" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg magnetic">
            Book a Discovery Call
            <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
