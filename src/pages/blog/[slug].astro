---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleShell from '../../components/content/ArticleShell.astro';
import { posts } from '../../data/posts';
import { articleJsonLd, breadcrumbJsonLd, faqJsonLd } from '../../data/content';

export function getStaticPaths() {
  return posts
    .filter((d) => !d.draft)
    .map((doc) => ({ params: { slug: doc.slug }, props: { doc } }));
}

const { doc } = Astro.props;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Insights', href: '/blog' },
  { name: doc.crumb ?? doc.title, href: `/blog/${doc.slug}` },
];
const jsonLd = [
  articleJsonLd(doc),
  breadcrumbJsonLd(crumbs),
  ...(doc.faq && doc.faq.length ? [faqJsonLd(doc.faq)] : []),
];
---

<BaseLayout
  title={doc.seoTitle ?? doc.title}
  description={doc.description}
  keywords={doc.keywords}
  image={doc.ogImage}
  jsonLd={jsonLd}
>
  <ArticleShell doc={doc} crumbs={crumbs} />
</BaseLayout>
