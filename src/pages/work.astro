---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Our Work | Diverse Labs: AI Agents, Web & Mobile Projects';
const description = 'Production-grade projects built by Diverse Labs: AI automation, web applications, mobile apps, fintech, and creator platforms. Real work, real results.';
const keywords = 'Diverse Labs portfolio, AI automation projects, web development case studies, mobile app development, production software examples';

const projects = [
  {
    name: 'NudgeFlow (for ClickPe, YC S23)',
    website: 'https://drive.google.com/file/d/10uMQ51a0u_D_SWAobehndmie-6HTT-lZ/view',
    image: '/work/nudgeflow.webp',
    description:
      'Customer support and lead generation automation for ClickPe. We built a WhatsApp chatbot plus a lead-generation call agent that classifies leads, triggers follow-ups, retries dropped journeys, and syncs outcomes to workflow systems.',
    ctaLabel: 'Watch demo video',
    ctaHref: 'https://drive.google.com/file/d/10uMQ51a0u_D_SWAobehndmie-6HTT-lZ/view',
  },
  {
    name: 'BloomersTV',
    website: 'https://bloomers.tv/',
    image: '/work/bloomerstv.webp',
    description:
      'A live streaming platform built around the Lens ecosystem, reflecting our ability to ship creator-focused and community-driven digital products with production quality.',
    ctaLabel: 'Visit website',
    ctaHref: 'https://bloomers.tv/',
  },
  {
    name: 'Paiso',
    website: 'https://paiso.xyz/',
    image: '/work/paiso.webp',
    description:
      'A consumer fintech app (live on Play Store) centered on fast cash and rewards, showing our experience in building user-facing financial product journeys with a clear growth and engagement focus.',
    ctaLabel: 'Visit website',
    ctaHref: 'https://paiso.xyz/',
  },
  {
    name: 'DANZ NOW',
    website: 'https://danz.now/',
    image: '/work/danz-now.webp',
    description:
      'A movement and event-based digital platform built around “Move. Connect. Earn.”, rewarding users for dancing, hosting events, and participating in community experiences.',
    ctaLabel: 'Visit website',
    ctaHref: 'https://danz.now/',
  },
  {
    name: 'Hand Protocol',
    website: 'https://handprotocol.org/',
    image: '/work/hand-protocol.webp',
    description:
      'A platform for public goods projects that connects impactful initiatives with donors and streamlines the contribution process through a clear digital experience.',
    ctaLabel: 'Visit website',
    ctaHref: 'https://handprotocol.org/',
  },
];

const aiVideos = [
  { id: '4Ekp3bFrF1M', label: 'Aguanea Can Showcase | AD Creative' },
  { id: 'SWuk4UW41gw', label: 'Fendi Boots AI Timelapse | AD Creative' },
  { id: 't_nK3JmUjNk', label: 'UGC Content with SFX and Overlay' },
  { id: 'zHxz5vNCBkQ', label: 'YSL | Luxury Product Showcase' },
  { id: 'ChPllafoxew', label: 'Katmaconie Heels AD Reel UGC' },
];
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <!-- Hero Section -->
  <section class="page-section-tight">
    <div class="container max-w-4xl mx-auto text-center">
      <div class="flex justify-center mb-7 reveal">
        <span class="badge">Selected Projects</span>
      </div>
      <h1 class="text-white font-extrabold mb-6 reveal reveal-delay-1">Production Work.<br />Real Results.</h1>
      <p class="text-xl text-text-secondary max-w-2xl mx-auto reveal reveal-delay-2">
        Every project shipped here is live, in production, and solving real problems for real businesses.
      </p>
    </div>
  </section>

  <!-- Tabs + Content -->
  <section class="page-section-tight pt-0">
    <div class="container max-w-6xl mx-auto">

      <!-- Tab navigation -->
      <div class="work-tabs reveal" role="tablist" aria-label="Work categories">
        <button class="work-tab-btn" id="tab-all" role="tab" aria-controls="panel-all" aria-selected="true" data-tab="all" type="button">
          All Projects
        </button>
        <button class="work-tab-btn" id="tab-ai-creatives" role="tab" aria-controls="panel-ai-creatives" aria-selected="false" data-tab="ai-creatives" type="button">
          AI Creatives
        </button>
      </div>

      <!-- Panel: All Projects -->
      <div class="work-tab-panel" id="panel-all" role="tabpanel" aria-labelledby="tab-all">
        <div class="text-center mb-14 reveal">
          <p class="section-label mb-4">Featured Projects</p>
          <h2 class="text-white font-bold">AI, Web, Mobile & Beyond</h2>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
          {projects.map((project, i) => (
            <article class={`group reveal reveal-delay-${(i % 2) + 1}`}>
              <a href={project.ctaHref} target="_blank" rel="noopener noreferrer" class="block">
                <div class="surface-card card-hover aspect-video rounded-xl mb-6 overflow-hidden">
                  <img
                    src={project.image}
                    alt={`${project.name} project screenshot`}
                    width="1280"
                    height="720"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                </div>
              </a>
              <h3 class="text-white font-bold text-xl mb-3 group-hover:text-gray-300 transition-colors">
                {project.name}
              </h3>
              <p class="text-text-secondary mb-5 leading-relaxed">{project.description}</p>
              <div class="flex items-center gap-4 flex-wrap">
                <a
                  href={project.ctaHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-white text-sm font-semibold hover:text-gray-300 transition-colors inline-flex items-center gap-1"
                >
                  {project.ctaLabel}
                  <span class="inline-block group-hover:translate-x-1 transition-transform">→</span>
                </a>
                <span class="text-border">·</span>
                <a
                  href={project.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-text-tertiary text-sm hover:text-text-primary transition-colors"
                >
                  {project.website.replace('https://', '').replace('http://', '').replace('www.', '')}
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>

      <!-- Panel: AI Creatives -->
      <div class="work-tab-panel" id="panel-ai-creatives" role="tabpanel" aria-labelledby="tab-ai-creatives">
        <div class="text-center mb-14 reveal">
          <p class="section-label mb-4">AI Video & UGC</p>
          <h2 class="text-white font-bold mb-4">AI-Generated Creatives</h2>
          <p class="text-lg text-text-secondary max-w-2xl mx-auto leading-relaxed">
            High-quality AI-generated ads and UGC videos with photorealistic avatars,
            natural voices, and brand-aligned messaging, produced by our creative team.
          </p>
        </div>
        <div class="ai-video-grid reveal">
          {aiVideos.map((v) => (
            <div class="ai-video-card">
              <div class="ai-video-embed">
                <iframe
                  src={`https://www.youtube.com/embed/${v.id}?rel=0&playsinline=1`}
                  title={v.label}
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  allowfullscreen
                  loading="lazy"
                ></iframe>
              </div>
              <div class="ai-video-label">{v.label}</div>
            </div>
          ))}
        </div>
        <div class="mt-16 text-center reveal">
          <p class="text-text-secondary mb-6 text-lg">
            Want AI-generated creatives for your brand?
          </p>
          <a href="https://cal.com/diverselabs/30min" target="_blank" rel="noopener noreferrer" class="btn btn-primary px-8 py-3.5 text-base">
            Book a Discovery Call
          </a>
        </div>
      </div>

      <div class="mt-24 surface-panel rounded-3xl p-10 md:p-14 text-center max-w-3xl mx-auto reveal">
        <h2 class="text-white font-bold mb-4">Your Project Could Be Next.</h2>
        <p class="text-text-secondary text-lg mb-8">
          Let's talk about what we can build and automate for you.
        </p>
        <a href="https://cal.com/diverselabs/30min" target="_blank" rel="noopener noreferrer" class="btn btn-primary px-8 py-3.5 text-base">
          Schedule a Discovery Call
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function initTabs() {
    const params = new URLSearchParams(window.location.search);
    const activeTab = params.get('tab') ?? 'all';

    const tabBtns = document.querySelectorAll<HTMLButtonElement>('.work-tab-btn');
    const tabPanels = document.querySelectorAll<HTMLElement>('.work-tab-panel');

    function activateTab(name: string) {
      tabBtns.forEach(btn => {
        const isActive = btn.dataset.tab === name;
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });
      tabPanels.forEach(panel => {
        panel.classList.toggle('active', panel.id === `panel-${name}`);
      });
      const url = new URL(window.location.href);
      if (name === 'all') {
        url.searchParams.delete('tab');
      } else {
        url.searchParams.set('tab', name);
      }
      history.replaceState(null, '', url.toString());
    }

    activateTab(activeTab);

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => activateTab(btn.dataset.tab ?? 'all'));
    });
  }

  if (document.readyState !== 'loading') initTabs();
  else document.addEventListener('DOMContentLoaded', initTabs);
  document.addEventListener('astro:page-load', initTabs);
</script>
