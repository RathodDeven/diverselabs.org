---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkShowcase from '../components/WorkShowcase.astro';

const title = 'AI Agent Case Studies & Client Work | Diverse Labs';
const description = 'Real AI agent case studies with numbers: Zoho CRM follow-up automation, WhatsApp and voice agents for ClickPe (YC S23), AI UGC ads, and more.';
const keywords = 'Diverse Labs portfolio, AI automation projects, web development case studies, mobile app development, production software examples';
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <WorkShowcase activeTab="all" />
</BaseLayout>
