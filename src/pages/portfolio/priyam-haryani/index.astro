---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTAButton from '../../../components/CTAButton.astro';
import PortfolioCard from '../../../components/PortfolioCard.astro';
import { portfolioCaseStudies, portfolioRecent, isHidden } from '../../../data/portfolio';

const BASE = '/portfolio/priyam-haryani';
const EMAIL = 'haryanipriyam@gmail.com';
// Locally (dev) show every engagement, including ones hidden from live (marked,
// with an unhide button). In the production build, hidden engagements drop off.
const cases = portfolioCaseStudies.filter(
  (d) => !d.draft && (import.meta.env.DEV || !isHidden(d.slug)),
);

// The two most recent engagements sit as a pair right under the hero; the
// year-by-year grid below lists everything else.
const recent = portfolioRecent.flatMap((slug) => cases.filter((d) => d.slug === slug));
const earlier = cases.filter((d) => !portfolioRecent.includes(d.slug));

// Year-wise segregation, group engagements by the latest year in their timeframe.
const yearOf = (tf?: string) => {
  const ys = (tf ?? '').match(/\d{4}/g)?.map(Number) ?? [];
  return ys.length ? Math.max(...ys) : 0;
};
const casesByYear = [...new Set(earlier.map((d) => yearOf(d.timeframe)))]
  .sort((a, b) => b - a)
  .map((year) => ({ year, items: earlier.filter((d) => yearOf(d.timeframe) === year) }));

// Honest at-a-glance stats, computed from committed data so they never drift.
const allYears = cases.flatMap((d) => (d.timeframe ?? '').match(/\d{4}/g)?.map(Number) ?? []);
const spanMin = allYears.length ? Math.min(...allYears) : 0;
const spanMax = allYears.length ? Math.max(...allYears) : 0;
const deliveredCount = cases.filter((d) => d.directlyDelivered).length;

// How client data is handled. The wording is deliberate: it promises exactly
// this and no more.
const dataRules = [
  { title: 'Where it says nothing leaves', desc: 'I work only in your tools.' },
  { title: 'Where it allows', desc: 'I use my own AI under NDA and keep no copies.' },
];

const lens = [
  { title: 'Incentives', desc: 'Model stakeholders as rational actors responding to the structures they face.' },
  { title: 'Coordination', desc: 'Find where handoffs fail, where communication breaks, and where duplication hides.' },
  { title: 'Governance', desc: 'Redesign decision rights, escalation paths and oversight structures.' },
  { title: 'Information flow', desc: 'Map how data and insight move, and where they get blocked or distorted.' },
];
---

<BaseLayout
  title="Priyam Haryani, AI-Powered Pharma Operations Consultant"
  description="AI-powered pharma operations consultant for consulting firms. When your team is stretched or an engagement's hours are nearly gone, I step in with almost no handover and deliver client-ready work under your name."
  image="/portfolio/og/_portfolio.png"
  noindex={true}
  standalone={true}
>
  <!-- Particle → graph scene (scroll-driven), behind content -->
  <canvas id="pf-scene" aria-hidden="true"></canvas>

  <!-- ── Hero ───────────────────────────────────────────────────────── -->
  <section class="pf-hero">
    <div class="container pf-z">
      <div class="pf-byline" data-reveal>
        <img
          class="pf-avatar"
          src="/people/priyam-haryani.webp"
          alt="Priyam Haryani"
          width="96"
          height="96"
          loading="eager"
          decoding="async"
        />
        <span class="label no-rule">For pharma consulting firms</span>
      </div>
      <h1 class="display-hero pf-title" data-reveal data-reveal-delay="0.1">Priyam Haryani</h1>
      <p class="pf-lede" data-reveal data-reveal-delay="0.2">
        I'm an AI-powered pharma operations consultant. When your team is stretched
        or an engagement's hours are nearly gone, I step in, pick it up from your
        folder with almost no handover, and deliver client-ready work under your name.
      </p>
      <div class="pf-cta-row" data-reveal data-reveal-delay="0.3">
        <CTAButton href={`mailto:${EMAIL}?subject=${encodeURIComponent('Hello, your portfolio')}`}>Email Priyam</CTAButton>
        <a href="#recent" class="btn btn-secondary">See two recent examples</a>
      </div>

      <dl class="pf-stats" data-reveal data-reveal-delay="0.4">
        <div class="pf-stat"><dt>{cases.length}</dt><dd>engagements</dd></div>
        <div class="pf-stat"><dt class="mono-num">{spanMin}–{spanMax}</dt><dd>active</dd></div>
        <div class="pf-stat"><dt>{deliveredCount}</dt><dd>delivered hands-on</dd></div>
      </dl>

    </div>
    <div class="pf-scroll-cue pf-z" aria-hidden="true">
      <span>Scroll</span>
      <span class="pf-scroll-line"></span>
    </div>
  </section>

  <!-- ── Recent pair ────────────────────────────────────────────────── -->
  {recent.length > 0 && (
    <section id="recent" class="page-section-tight pf-z">
      <div class="container">
        <div class="section-head" data-reveal>
          <h2>Two recent examples.</h2>
          <span class="head-side">November 2026</span>
        </div>
        <div class="pf-grid" data-reveal-group>
          {recent.map((doc) => <PortfolioCard doc={doc} base={BASE} />)}
        </div>
      </div>
    </section>
  )}

  <!-- ── Client data ────────────────────────────────────────────────── -->
  <section id="data" class="page-section-tight pf-z">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>How I handle your client's data.</h2>
        <span class="head-side">Data</span>
      </div>
      <p class="pf-approach-intro pf-data-lead" data-reveal>I follow your client's data protocol.</p>
      <div class="pf-lens pf-data" data-reveal-group>
        {dataRules.map((r) => (
          <div class="pf-lens-card">
            <h3>{r.title}</h3>
            <p>{r.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Approach / lens ────────────────────────────────────────────── -->
  <section class="page-section-tight pf-z">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>Understanding why systems fail.</h2>
        <span class="head-side">The lens</span>
      </div>
      <p class="pf-approach-intro" data-reveal>
        Most organizational failures are not capability problems. They are failures of
        incentives, coordination, governance design and information flow. That is the
        lens I bring to every engagement, direct, and through consulting firms.
      </p>
      <div class="pf-lens" data-reveal-group>
        {lens.map((l) => (
          <div class="pf-lens-card">
            <h3>{l.title}</h3>
            <p>{l.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Selected work ──────────────────────────────────────────────── -->
  <section id="work" class="page-section pf-z">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>Engagements, anonymized.</h2>
        <span class="head-side">{String(earlier.length).padStart(2, '0')} case studies</span>
      </div>
      <p class="pf-approach-intro pf-approach-lead" data-reveal>
        Since {spanMin} I have worked with consulting firms and in-house teams as embedded
        senior delivery, owning the models, playbooks, analytics and launch plans their
        engagements run on, from clinical-stage biotechs to the world's largest pharma.
      </p>
      <p class="pf-approach-intro" data-reveal>
        Representative work across pharma and biotech operations: supply chain and launch
        readiness, CMC, packaging and labeling, quality systems, BI analytics, and applied
        AI agents. Client identities are anonymized; the problems and the work are real.
      </p>

      {casesByYear.map(({ year, items }) => (
        <div class="pf-year">
          <div class="pf-year-head" data-reveal>
            <span class="pf-year-num">{year}</span>
            <span class="pf-year-rule"></span>
            <span class="pf-year-count">{items.length} {items.length === 1 ? 'engagement' : 'engagements'}</span>
          </div>
          <div class="pf-grid" data-reveal-group>
            {items.map((doc) => <PortfolioCard doc={doc} base={BASE} />)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ── Closing CTA ────────────────────────────────────────────────── -->
  <section class="page-section-tight pf-z">
    <div class="container container-narrow">
      <div class="doc-cta" data-reveal>
        <h2>Team stretched, or hours nearly gone?</h2>
        <p>Tell me what is due and when. I can pick it up from your folder with almost no handover.</p>
        <CTAButton href={`mailto:${EMAIL}?subject=${encodeURIComponent('Hello, your portfolio')}`}>Email Priyam · {EMAIL}</CTAButton>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Particle scene canvas, above the shader (-1), below content (.pf-z = 1) */
  #pf-scene {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }
  .pf-z { position: relative; z-index: 1; }

  .pf-hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    padding-top: 7rem;
    padding-bottom: 4rem;
  }
  .pf-hero .container { position: relative; z-index: 1; }
  .pf-title { margin: 1.4rem 0 0; }
  .pf-lede {
    margin-top: 1.6rem;
    max-width: 40rem;
    font-size: clamp(1.05rem, 1.7vw, 1.3rem);
    color: var(--muted);
    line-height: 1.6;
  }
  .pf-cta-row {
    margin-top: 2.2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    align-items: center;
  }

  /* Honest stat band (computed from committed data) */
  .pf-stats {
    margin-top: clamp(2rem, 4vw, 2.6rem);
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.6rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
    padding-top: 1.4rem;
    max-width: 40rem;
  }
  .pf-stat dt {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
    line-height: 1;
  }
  .pf-stat dd {
    margin: 0.45rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .pf-scroll-cue {
    position: absolute;
    bottom: 1.8rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .pf-scroll-line {
    width: 1px;
    height: 2.6rem;
    background: rgba(255, 255, 255, 0.14);
  }

  .pf-approach-intro {
    max-width: 52ch;
    color: var(--muted);
    margin-bottom: clamp(2rem, 4vw, 3rem);
    font-size: 1.02rem;
  }

  /* Hero avatar byline */
  .pf-byline { display: flex; align-items: center; gap: 0.85rem; margin-bottom: 0.3rem; }
  .pf-avatar {
    width: 3.1rem;
    height: 3.1rem;
    border-radius: 50%;
    object-fit: cover;
    object-position: top;
    border: 1px solid var(--line);
    filter: grayscale(1) contrast(1.04);
    transition: filter 0.5s ease, border-color 0.4s ease;
    flex-shrink: 0;
  }
  .pf-byline:hover .pf-avatar { filter: grayscale(0); border-color: rgba(255, 255, 255, 0.28); }

  .pf-lens {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 1rem;
    overflow: hidden;
  }
  @media (min-width: 880px) { .pf-lens { grid-template-columns: repeat(4, 1fr); } }
  .pf-lens-card { background: var(--panel); padding: clamp(1.4rem, 2.4vw, 2rem); }
  .pf-lens-card h3 { font-size: 1.05rem; margin-bottom: 0.55rem; }
  .pf-lens-card p { font-size: 0.9rem; color: var(--muted); line-height: 1.6; }

  /* Client-data promise: two plain rules, side by side from tablet width up */
  .pf-data { grid-template-columns: 1fr; max-width: 52rem; }
  @media (min-width: 640px) { .pf-data { grid-template-columns: repeat(2, 1fr); } }
  .pf-data .pf-lens-card p { font-size: 1.02rem; color: var(--ink); }
  .pf-data-lead {
    color: var(--ink);
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    margin-bottom: 1.4rem;
  }

  /* Two intro paragraphs in a row: tighten the gap between them */
  .pf-approach-lead { margin-bottom: 1rem; }

  /* Year-wise segregation */
  .pf-year { margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .pf-year:last-child { margin-bottom: 0; }
  .pf-year-head {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: clamp(1.25rem, 2.5vw, 1.75rem);
  }
  .pf-year-num {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 4vw, 2.6rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--ink);
    line-height: 1;
  }
  .pf-year-rule { flex: 1; height: 1px; background: var(--line); align-self: center; }
  .pf-year-count {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
    white-space: nowrap;
  }

  /* Case-study grid */
  .pf-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  @media (min-width: 720px) { .pf-grid { grid-template-columns: 1fr 1fr; } }

  @media (max-width: 760px) { .pf-scroll-cue { display: none; } }
</style>

<script>
  import { initPortfolioScene } from '../../../scripts/portfolio-scene';

  let cleanup: (() => void) | undefined;

  function start() {
    const canvas = document.getElementById('pf-scene') as HTMLCanvasElement | null;
    if (!canvas || cleanup) return; // not on this page, or already running
    const isMobile = window.innerWidth < 768;
    const lowPower = navigator.hardwareConcurrency ? navigator.hardwareConcurrency <= 4 : false;
    cleanup = initPortfolioScene(canvas, {
      reducedQuality: isMobile || lowPower,
    });
  }

  function stop() {
    if (cleanup) { cleanup(); cleanup = undefined; }
  }

  start();
  document.addEventListener('astro:page-load', start);
  document.addEventListener('astro:before-swap', stop);
</script>

<script>
  // Dev-only: Hide/Unhide a case study from the live build. Stripped from production.
  if (import.meta.env.DEV) {
    const bindHide = () => {
      document.querySelectorAll<HTMLButtonElement>('.pf-hide-btn').forEach((b) => {
        if (b.dataset.bound) return;
        b.dataset.bound = 'true';
        b.addEventListener('click', async (e) => {
          e.preventDefault();
          e.stopPropagation();
          b.disabled = true;
          const prev = b.textContent;
          b.textContent = '…';
          try {
            await fetch('/__pf-hide', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ slug: b.dataset.slug }),
            });
            location.reload();
          } catch {
            b.disabled = false;
            b.textContent = prev;
          }
        });
      });
    };
    bindHide();
    document.addEventListener('astro:page-load', bindHide);
  }
</script>
