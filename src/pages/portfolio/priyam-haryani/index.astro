---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTAButton from '../../../components/CTAButton.astro';
import { portfolioCaseStudies, coverFor, isHidden } from '../../../data/portfolio';

const BASE = '/portfolio/priyam-haryani';
const EMAIL = 'haryanipriyam@gmail.com';
// Locally (dev) show every engagement, including ones hidden from live (marked,
// with an unhide button). In the production build, hidden engagements drop off.
const cases = portfolioCaseStudies.filter(
  (d) => !d.draft && (import.meta.env.DEV || !isHidden(d.slug)),
);

// Year-wise segregation, group engagements by the latest year in their timeframe.
const yearOf = (tf?: string) => {
  const ys = (tf ?? '').match(/\d{4}/g)?.map(Number) ?? [];
  return ys.length ? Math.max(...ys) : 0;
};
const casesByYear = [...new Set(cases.map((d) => yearOf(d.timeframe)))]
  .sort((a, b) => b - a)
  .map((year) => ({ year, items: cases.filter((d) => yearOf(d.timeframe) === year) }));

const lens = [
  { title: 'Incentives', desc: 'Model stakeholders as rational actors responding to the structures they face.' },
  { title: 'Coordination', desc: 'Find where handoffs fail, where communication breaks, and where duplication hides.' },
  { title: 'Governance', desc: 'Redesign decision rights, escalation paths and oversight structures.' },
  { title: 'Information flow', desc: 'Map how data and insight move, and where they get blocked or distorted.' },
];
---

<BaseLayout
  title="Priyam Haryani, Independent Advisor, Pharma & Biotech Operations"
  description="Economist and management consultant working on the operational, quality and regulatory problems pharma and biotech companies would rather not have. Selected engagements, anonymized."
  image="/portfolio/og/_portfolio.png"
  noindex={true}
  standalone={true}
>
  <!-- Particle → graph scene (scroll-driven), behind content -->
  <canvas id="pf-scene" aria-hidden="true"></canvas>

  <!-- ── Hero ───────────────────────────────────────────────────────── -->
  <section class="pf-hero">
    <div class="container pf-z">
      <div class="pf-byline" data-reveal>
        <img
          class="pf-avatar"
          src="/people/priyam-haryani.webp"
          alt="Priyam Haryani"
          width="96"
          height="96"
          loading="eager"
          decoding="async"
        />
        <span class="label no-rule">Independent Advisory</span>
      </div>
      <h1 class="display-hero pf-title" data-reveal data-reveal-delay="0.1">Priyam Haryani</h1>
      <p class="pf-lede" data-reveal data-reveal-delay="0.2">
        Economist and management consultant. I work on the operational, quality and
        regulatory problems pharma and biotech companies would rather not have.
      </p>
      <div class="pf-cta-row" data-reveal data-reveal-delay="0.3">
        <CTAButton href={`mailto:${EMAIL}?subject=${encodeURIComponent('Hello, your portfolio')}`}>Email Priyam</CTAButton>
        <a href="#work" class="btn btn-secondary">View selected work</a>
      </div>

    </div>
    <div class="pf-scroll-cue pf-z" aria-hidden="true">
      <span>Scroll</span>
      <span class="pf-scroll-line"></span>
    </div>
  </section>

  <!-- ── Approach / lens ────────────────────────────────────────────── -->
  <section class="page-section-tight pf-z">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>Understanding why systems fail.</h2>
        <span class="head-side">The lens</span>
      </div>
      <p class="pf-approach-intro" data-reveal>
        Most organizational failures are not capability problems. They are failures of
        incentives, coordination, governance design and information flow. That is the
        lens I bring to every engagement, direct, and through consulting firms.
      </p>
      <div class="pf-lens" data-reveal-group>
        {lens.map((l) => (
          <div class="pf-lens-card">
            <h3>{l.title}</h3>
            <p>{l.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Selected work ──────────────────────────────────────────────── -->
  <section id="work" class="page-section pf-z">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>Engagements, anonymized.</h2>
        <span class="head-side">{String(cases.length).padStart(2, '0')} case studies</span>
      </div>
      <p class="pf-approach-intro" data-reveal>
        Representative work across pharma and biotech operations, supply chain, launch
        readiness, quality, analytics and applied AI. Client identities are anonymized;
        the problems and the work are real.
      </p>

      {casesByYear.map(({ year, items }) => (
        <div class="pf-year">
          <div class="pf-year-head" data-reveal>
            <span class="pf-year-num">{year}</span>
            <span class="pf-year-rule"></span>
            <span class="pf-year-count">{items.length} {items.length === 1 ? 'engagement' : 'engagements'}</span>
          </div>
          <div class="pf-grid" data-reveal-group>
            {items.map((doc) => (
              <div class:list={['pf-card-wrap', { 'is-hidden': import.meta.env.DEV && isHidden(doc.slug) }]}>
                <a class="pf-card" href={`${BASE}/${doc.slug}`}>
                  <div class="pf-card-media">
                    <img src={coverFor(doc.slug)} alt="" loading="lazy" width="640" height="400" />
                  </div>
                  <div class="pf-card-body">
                    {doc.client && (
                      <div class="pf-card-client"><span>Client</span>{doc.client}</div>
                    )}
                    <div class="pf-card-top">
                      <span class="label no-rule">{doc.eyebrow}</span>
                      <span class="pf-card-idx mono-num">{doc.timeframe}</span>
                    </div>
                    <h3 class="pf-card-title">{doc.title}</h3>
                    <p class="pf-card-dek">{doc.dek}</p>
                    <div class="pf-card-foot">
                      <div class="pf-card-tags">
                        {doc.tags.slice(0, 3).map((t) => <span class="chip">{t}</span>)}
                      </div>
                      <span class="pf-card-arrow" aria-hidden="true">→</span>
                    </div>
                  </div>
                </a>
                {import.meta.env.DEV && (
                  <>
                    {isHidden(doc.slug) && <span class="pf-hidden-badge">Hidden from live</span>}
                    <button class="pf-hide-btn" type="button" data-slug={doc.slug}>
                      {isHidden(doc.slug) ? 'Unhide' : 'Hide from live'}
                    </button>
                  </>
                )}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ── Closing CTA ────────────────────────────────────────────────── -->
  <section class="page-section-tight pf-z">
    <div class="container container-narrow">
      <div class="doc-cta" data-reveal>
        <h2>A problem worth solving?</h2>
        <p>Operational, quality or regulatory, if it's the kind of thing teams would rather not have, let's talk.</p>
        <CTAButton href={`mailto:${EMAIL}?subject=${encodeURIComponent('Hello, your portfolio')}`}>Email Priyam · {EMAIL}</CTAButton>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Particle scene canvas, above the shader (-1), below content (.pf-z = 1) */
  #pf-scene {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }
  .pf-z { position: relative; z-index: 1; }

  .pf-hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    padding-top: 7rem;
    padding-bottom: 4rem;
  }
  .pf-hero .container { position: relative; z-index: 1; }
  .pf-title { margin: 1.4rem 0 0; }
  .pf-lede {
    margin-top: 1.6rem;
    max-width: 40rem;
    font-size: clamp(1.05rem, 1.7vw, 1.3rem);
    color: var(--muted);
    line-height: 1.6;
  }
  .pf-cta-row {
    margin-top: 2.2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    align-items: center;
  }

  .pf-scroll-cue {
    position: absolute;
    bottom: 1.8rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .pf-scroll-line {
    width: 1px;
    height: 2.6rem;
    background: rgba(255, 255, 255, 0.14);
  }

  .pf-approach-intro {
    max-width: 52ch;
    color: var(--muted);
    margin-bottom: clamp(2rem, 4vw, 3rem);
    font-size: 1.02rem;
  }

  /* Hero avatar byline */
  .pf-byline { display: flex; align-items: center; gap: 0.85rem; margin-bottom: 0.3rem; }
  .pf-avatar {
    width: 3.1rem;
    height: 3.1rem;
    border-radius: 50%;
    object-fit: cover;
    object-position: top;
    border: 1px solid var(--line);
    filter: grayscale(1) contrast(1.04);
    transition: filter 0.5s ease, border-color 0.4s ease;
    flex-shrink: 0;
  }
  .pf-byline:hover .pf-avatar { filter: grayscale(0); border-color: rgba(255, 255, 255, 0.28); }

  .pf-lens {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 1rem;
    overflow: hidden;
  }
  @media (min-width: 880px) { .pf-lens { grid-template-columns: repeat(4, 1fr); } }
  .pf-lens-card { background: var(--panel); padding: clamp(1.4rem, 2.4vw, 2rem); }
  .pf-lens-card h3 { font-size: 1.05rem; margin-bottom: 0.55rem; }
  .pf-lens-card p { font-size: 0.9rem; color: var(--muted); line-height: 1.6; }

  /* Year-wise segregation */
  .pf-year { margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .pf-year:last-child { margin-bottom: 0; }
  .pf-year-head {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: clamp(1.25rem, 2.5vw, 1.75rem);
  }
  .pf-year-num {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 4vw, 2.6rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--ink);
    line-height: 1;
  }
  .pf-year-rule { flex: 1; height: 1px; background: var(--line); align-self: center; }
  .pf-year-count {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
    white-space: nowrap;
  }

  /* Case-study grid */
  .pf-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  @media (min-width: 720px) { .pf-grid { grid-template-columns: 1fr 1fr; } }

  /* Dev-only hide/unhide controls (stripped from the production build) */
  .pf-card-wrap { position: relative; display: flex; }
  .pf-card-wrap .pf-card { flex: 1; }
  .pf-card-wrap.is-hidden .pf-card { opacity: 0.42; filter: grayscale(0.6); }
  .pf-card-wrap.is-hidden { outline: 1px dashed rgba(255, 120, 120, 0.5); outline-offset: 3px; border-radius: 1.1rem; }
  .pf-hide-btn {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    z-index: 4;
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.32rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    background: rgba(10, 10, 10, 0.82);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--muted);
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .pf-hide-btn:hover { color: var(--ink); border-color: rgba(255, 255, 255, 0.3); }
  .pf-hide-btn[disabled] { opacity: 0.5; cursor: default; }
  .pf-hidden-badge {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    z-index: 4;
    font-family: var(--font-mono);
    font-size: 0.54rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.3rem 0.5rem;
    border-radius: 0.5rem;
    background: rgba(120, 20, 20, 0.55);
    border: 1px solid rgba(255, 120, 120, 0.45);
    color: #ffd9d9;
  }

  .pf-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 1.1rem;
    background: var(--panel);
    overflow: hidden;
    transition: border-color 250ms var(--ease-out), transform 400ms var(--ease-out);
  }
  .pf-card:hover { border-color: rgba(255, 255, 255, 0.2); transform: translateY(-4px); }
  .pf-card-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #0a0a0a;
    border-bottom: 1px solid var(--line);
  }
  .pf-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 500ms var(--ease-out);
  }
  .pf-card:hover .pf-card-media img { transform: scale(1.04); }
  .pf-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: clamp(1.3rem, 2.2vw, 1.7rem);
    flex: 1;
  }
  .pf-card-client {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .pf-card-client span {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .pf-card-top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .pf-card-idx { font-size: 0.72rem; color: var(--faint); }
  .pf-card-title {
    font-size: clamp(1.15rem, 1.9vw, 1.4rem);
    line-height: 1.25;
    color: var(--ink);
  }
  .pf-card-dek { font-size: 0.92rem; color: var(--muted); line-height: 1.6; flex: 1; }
  .pf-card-foot { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 0.2rem; }
  .pf-card-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .pf-card-arrow {
    flex-shrink: 0;
    color: var(--ink);
    transition: transform 300ms var(--ease-out);
  }
  .pf-card:hover .pf-card-arrow { transform: translateX(4px); }

  @media (max-width: 760px) { .pf-scroll-cue { display: none; } }
</style>

<script>
  import { initPortfolioScene } from '../../../scripts/portfolio-scene';

  let cleanup: (() => void) | undefined;

  function start() {
    const canvas = document.getElementById('pf-scene') as HTMLCanvasElement | null;
    if (!canvas || cleanup) return; // not on this page, or already running
    const isMobile = window.innerWidth < 768;
    const lowPower = navigator.hardwareConcurrency ? navigator.hardwareConcurrency <= 4 : false;
    cleanup = initPortfolioScene(canvas, {
      reducedQuality: isMobile || lowPower,
    });
  }

  function stop() {
    if (cleanup) { cleanup(); cleanup = undefined; }
  }

  start();
  document.addEventListener('astro:page-load', start);
  document.addEventListener('astro:before-swap', stop);
</script>

<script>
  // Dev-only: Hide/Unhide a case study from the live build. Stripped from production.
  if (import.meta.env.DEV) {
    const bindHide = () => {
      document.querySelectorAll<HTMLButtonElement>('.pf-hide-btn').forEach((b) => {
        if (b.dataset.bound) return;
        b.dataset.bound = 'true';
        b.addEventListener('click', async (e) => {
          e.preventDefault();
          e.stopPropagation();
          b.disabled = true;
          const prev = b.textContent;
          b.textContent = '…';
          try {
            await fetch('/__pf-hide', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ slug: b.dataset.slug }),
            });
            location.reload();
          } catch {
            b.disabled = false;
            b.textContent = prev;
          }
        });
      });
    };
    bindHide();
    document.addEventListener('astro:page-load', bindHide);
  }
</script>
