---
import BackgroundShader from '../components/BackgroundShader.astro';
import CTAButton from '../components/CTAButton.astro';
import '../styles/global.css';
import ClientRouter from 'astro/components/ClientRouter.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  keywords?: string;
  /** When true, emit robots noindex,nofollow (for hidden / unlisted pages) */
  noindex?: boolean;
  /** When true, hide the site nav + footer entirely (sealed / standalone page) */
  standalone?: boolean;
  /** When true, skip the fixed BackgroundShader canvas (pages with their own WebGL) */
  hideBackdrop?: boolean;
  /** When true, omit the footer's big CTA row (pages that end on their own CTA) */
  hideFooterCta?: boolean;
  /** Extra per-page JSON-LD objects (Article, Service, HowTo, FAQPage, BreadcrumbList, …) */
  jsonLd?: Record<string, unknown>[];
}

const {
  title = 'Diverse Labs — AI Systems & Software Development',
  description = 'Diverse Labs builds custom AI agents, workflow automation, and production-grade software (web apps, mobile apps, desktop) for businesses that want to scale without adding headcount.',
  image = '/og-image.png',
  canonicalURL,
  keywords = 'AI agents, workflow automation, custom AI systems, web app development, mobile app development, AI chatbot, business automation, AI consulting, LLM integration',
  noindex = false,
  standalone = false,
  hideBackdrop = false,
  hideFooterCta = false,
  jsonLd = [],
} = Astro.props as Props;

const actualTitle = title;
const actualCanonicalURL = canonicalURL || Astro.url.href;
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const currentPath = Astro.url.pathname;
const isActive = (path: string) =>
  path === '/' ? currentPath === '/' : currentPath.startsWith(path);

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/work', label: 'Work' },
  { href: '/blog', label: 'Insights' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://diverselabs.org/#organization",
  "name": "Diverse Labs",
  "alternateName": "Diverse Labs AI",
  "description": "Diverse Labs is an AI automation agency building custom AI agents, workflow automation, and production-grade software for businesses. We specialize in AI-powered customer support, lead generation, product discovery, and end-to-end software development.",
  "url": "https://diverselabs.org",
  "logo": "https://diverselabs.org/logo.svg",
  "image": "https://diverselabs.org/og-image.png",
  "email": "deven@diverselabs.org",
  "sameAs": [
    "https://www.linkedin.com/company/diverse-labs-org",
    "https://x.com/diverse_labs"
  ],
  "areaServed": "Worldwide",
  "priceRange": "$$",
  "knowsAbout": [
    "Artificial Intelligence",
    "AI Agents",
    "Large Language Models",
    "Business Process Automation",
    "Workflow Automation",
    "Web Application Development",
    "Mobile Application Development",
    "Machine Learning",
    "CRM Integration",
    "Customer Support Automation",
    "Lead Generation Automation"
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "AI Systems & Software Development Services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "AI Customer Support Agents" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "AI Lead Generation Systems" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Intelligent Product Discovery" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Web Application Development" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Mobile App Development" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Custom Machine Learning Pipelines" } }
    ]
  }
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Diverse Labs",
  "url": "https://diverselabs.org",
  "description": "Custom AI systems and software development for businesses that compete to scale.",
  "publisher": { "@id": "https://diverselabs.org/#organization" }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="author" content="Diverse Labs" />

    <script is:inline>
      document.documentElement.classList.add('js');
      // ClientRouter swaps strip ALL <html> attributes (class included) and
      // never re-run identical inline scripts — restore the class after swaps
      document.addEventListener('astro:after-swap', function () {
        document.documentElement.classList.add('js');
      });
      // Failsafe: if the motion script hasn't initialized within 2s (slow/failed
      // load), force the reveal-hidden content visible so the page is never blank.
      setTimeout(function () {
        if (!window.__motionReady) document.documentElement.classList.add('motion-failsafe');
      }, 2000);
    </script>

    <!-- Open Graph -->
    <meta property="og:title" content={actualTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={actualCanonicalURL} />
    <meta property="og:site_name" content="Diverse Labs" />

    <!-- Twitter Card -->
    <meta name="twitter:title" content={actualTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.url)} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Canonical -->
    <link rel="canonical" href={actualCanonicalURL} />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&family=Inter:wght@400;450;500;550;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <title>{actualTitle}</title>

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {jsonLd.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Astro View Transitions -->
    <ClientRouter />

    {gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){window.dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
  </head>
  <body>
    <!-- Custom cursor (desktop) -->
    <div class="cursor-glow" id="cursor-glow" aria-hidden="true"></div>
    <div class="cursor-dot" id="cursor-dot" aria-hidden="true"></div>
    <div class="cursor-ring" id="cursor-ring" aria-hidden="true"></div>
    <div class="cursor-ripple" id="cursor-ripple" aria-hidden="true"></div>

    <!-- Scroll progress indicator -->
    <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>

    {!hideBackdrop && <BackgroundShader />}

    {!standalone && (
    <>
    <!-- Navigation -->
    <header id="site-nav">
      <nav class="nav-inner" aria-label="Main navigation">
        <a href="/" class="nav-logo" aria-label="Diverse Labs home">
          <img src="/logo.svg" alt="" width="28" height="28" />
          Diverse&nbsp;Labs
        </a>

        <ul class="nav-links" role="list">
          {navItems.map((item) => (
            <li>
              <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>
                {item.label}
              </a>
            </li>
          ))}
          <li>
            <a href="https://cal.com/diverselabs/30min"
               target="_blank"
               rel="noopener noreferrer"
               class="btn btn-primary nav-cta text-sm py-2.5 px-5">
              Book a Call
            </a>
          </li>
        </ul>

        <button class="menu-btn" id="menu-btn" aria-label="Toggle menu" aria-expanded="false" aria-controls="menu-overlay">
          <span></span>
          <span></span>
        </button>
      </nav>
    </header>

    <!-- Full-screen mobile menu -->
    <div class="menu-overlay" id="menu-overlay" aria-hidden="true">
      <nav aria-label="Mobile navigation">
        {navItems.map((item, i) => (
          <a href={item.href} class="menu-link">
            <span class="menu-idx">0{i + 1}</span>
            {item.label}
          </a>
        ))}
        <a href="https://cal.com/diverselabs/30min" target="_blank" rel="noopener noreferrer" class="menu-link">
          <span class="menu-idx">0{navItems.length + 1}</span>
          Book a Call
        </a>
      </nav>
      <div class="menu-foot">
        <a href="mailto:deven@diverselabs.org">deven@diverselabs.org</a>
        <span>Building AI systems worldwide</span>
      </div>
    </div>

    </>
    )}

    <!-- Main content slot -->
    <main id="main-content">
      <slot />
    </main>

    {!standalone && (
    <!-- Footer -->
    <footer class="site-footer" role="contentinfo">
      <div class="container">
        {!hideFooterCta && (
        <div class="footer-cta-row">
          <h2>Have a system in mind? Let's scope it.</h2>
          <CTAButton href="https://cal.com/diverselabs/30min">Book a Discovery Call</CTAButton>
        </div>
        )}

        <div class="footer-grid">
          <div class="footer-col">
            <a href="/" class="nav-logo mb-4" style="display:inline-flex">
              <img src="/logo.svg" alt="" width="26" height="26" />
              Diverse&nbsp;Labs
            </a>
            <p class="footer-blurb">Custom AI systems and production software for teams that want to move faster.</p>
          </div>

          <div class="footer-col">
            <h4>Site</h4>
            <ul role="list">
              <li><a href="/" class="footer-link">Home</a></li>
              <li><a href="/services" class="footer-link">Services</a></li>
              <li><a href="/work" class="footer-link">Work</a></li>
              <li><a href="/blog" class="footer-link">Insights</a></li>
              <li><a href="/about" class="footer-link">About</a></li>
              <li><a href="/contact" class="footer-link">Contact</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h4>Case studies</h4>
            <ul role="list">
              <li><a href="/work/scaleup-zoho-crm-follow-up-agent" class="footer-link">Zoho CRM follow-up agent</a></li>
              <li><a href="/work/clickpe-nudgeflow-whatsapp-voice-ai-agent" class="footer-link">WhatsApp + voice lead agent</a></li>
              <li><a href="/work/distributor-catalog-automation" class="footer-link">Distributor catalog pipeline</a></li>
              <li><a href="/work/ai-creatives" class="footer-link">AI creatives</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h4>Connect</h4>
            <ul role="list">
              <li><a href="mailto:deven@diverselabs.org" class="footer-link">deven@diverselabs.org</a></li>
              <li>
                <a href="https://www.linkedin.com/company/diverse-labs-org" target="_blank" rel="noopener noreferrer" class="footer-link">
                  LinkedIn <span aria-hidden="true">↗</span>
                </a>
              </li>
              <li>
                <a href="https://x.com/diverse_labs" target="_blank" rel="noopener noreferrer" class="footer-link">
                  X (Twitter) <span aria-hidden="true">↗</span>
                </a>
              </li>
              <li>
                <a href="https://cal.com/diverselabs/30min" target="_blank" rel="noopener noreferrer" class="footer-link">
                  Book a call <span aria-hidden="true">↗</span>
                </a>
              </li>
            </ul>
          </div>
        </div>

        <a href="/" class="footer-mark" aria-label="Diverse Labs home">DIVERSE LABS</a>

        <div class="footer-base">
          <span>&copy; 2026 Diverse Labs</span>
          <span>Engineering-first. Outcome-driven.</span>
        </div>
      </div>
    </footer>
    )}

    <!-- Motion system (Lenis + GSAP) -->
    <script>
      import '../scripts/motion';
    </script>

    <!-- UI behaviours: menu, accordions, progress, cursor, click sparks -->
    <script>
      // ── Mobile menu ──────────────────────────────────────────────
      function bindMenu() {
        const btn = document.getElementById('menu-btn');
        const overlay = document.getElementById('menu-overlay');
        if (!btn || !overlay || btn.dataset.bound) return;
        btn.dataset.bound = 'true';

        const setOpen = (open: boolean) => {
          document.body.classList.toggle('menu-open', open);
          btn.setAttribute('aria-expanded', String(open));
          overlay.setAttribute('aria-hidden', String(!open));
          const lenis = (window as any).__lenis;
          if (lenis) open ? lenis.stop() : lenis.start();
          document.documentElement.style.overflow = open ? 'hidden' : '';
        };

        btn.addEventListener('click', () =>
          setOpen(!document.body.classList.contains('menu-open'))
        );
        overlay.querySelectorAll('a').forEach((a) =>
          a.addEventListener('click', () => setOpen(false))
        );
        document.addEventListener('astro:before-swap', () => setOpen(false));
      }

      // ── Generic accordion (.acc-item > .acc-head) ────────────────
      function bindAccordions() {
        document.querySelectorAll<HTMLElement>('.acc-head').forEach((head) => {
          if (head.dataset.bound) return;
          head.dataset.bound = 'true';
          head.addEventListener('click', () => {
            const item = head.closest('.acc-item');
            if (!item) return;
            const isOpen = item.classList.contains('open');
            item
              .closest('.acc-group')
              ?.querySelectorAll('.acc-item.open')
              .forEach((el) => {
                el.classList.remove('open');
                el.querySelector('.acc-head')?.setAttribute('aria-expanded', 'false');
              });
            item.classList.toggle('open', !isOpen);
            head.setAttribute('aria-expanded', String(!isOpen));
          });
        });
      }

      // ── Scroll progress bar ──────────────────────────────────────
      let progressRaf = 0;
      function updateProgress() {
        if (progressRaf) return;
        progressRaf = requestAnimationFrame(() => {
          progressRaf = 0;
          const bar = document.getElementById('scroll-progress');
          if (!bar) return;
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const scrolled = max > 0 ? window.scrollY / max : 0;
          bar.style.transform = `scaleX(${Math.min(scrolled, 1)})`;
        });
      }
      window.addEventListener('scroll', updateProgress, { passive: true });

      function initAll() {
        bindMenu();
        bindAccordions();
        updateProgress();
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAll);
      } else {
        initAll();
      }
      document.addEventListener('astro:page-load', initAll);

      // ── Click burst particles (spark lines) ──────────────────────
      ;(function () {
        if (!window.matchMedia('(pointer: fine)').matches) return;
        const bc = document.createElement('canvas');
        bc.style.cssText = 'position:fixed;inset:0;pointer-events:none;z-index:99997;';
        document.body.appendChild(bc);
        const bctx = bc.getContext('2d');
        if (!bctx) return;
        function resizeBC() { bc.width = window.innerWidth; bc.height = window.innerHeight; }
        resizeBC();
        window.addEventListener('resize', resizeBC, { passive: true });
        // View transitions swap <body>, detaching the canvas — re-attach it
        document.addEventListener('astro:after-swap', () => {
          if (!bc.isConnected) document.body.appendChild(bc);
          resizeBC();
        });
        type SP = { x: number; y: number; vx: number; vy: number; life: number; len: number; a: number; kind: 'spark' | 'flash'; };
        const sps: SP[] = [];
        let braf: number | null = null;
        function spawnBurst(x: number, y: number) {
          sps.push({ x, y, vx: 0, vy: 0, life: 1, len: 0, a: 0, kind: 'flash' });
          const n = 9;
          for (let i = 0; i < n; i++) {
            const a = (Math.PI * 2 / n) * i + (Math.random() - 0.5) * 0.45;
            const spd = Math.random() * 4.5 + 2;
            sps.push({ x, y, vx: Math.cos(a) * spd, vy: Math.sin(a) * spd,
              life: 1, len: Math.random() * 9 + 4, a, kind: 'spark' });
          }
          if (!braf) braf = requestAnimationFrame(drawBurst);
        }
        function drawBurst() {
          bctx!.clearRect(0, 0, bc.width, bc.height);
          for (let i = sps.length - 1; i >= 0; i--) {
            const p = sps[i];
            if (p.kind === 'flash') {
              p.life -= 0.14;
              if (p.life <= 0) { sps.splice(i, 1); continue; }
              const r = 18 * (1 - p.life);
              const grad = bctx!.createRadialGradient(p.x, p.y, 0, p.x, p.y, r);
              grad.addColorStop(0, `rgba(255,255,255,${p.life * 0.35})`);
              grad.addColorStop(1, 'rgba(255,255,255,0)');
              bctx!.beginPath();
              bctx!.arc(p.x, p.y, r, 0, Math.PI * 2);
              bctx!.fillStyle = grad;
              bctx!.fill();
            } else {
              p.x += p.vx; p.y += p.vy;
              p.vx *= 0.91; p.vy = p.vy * 0.91 + 0.09;
              p.life -= 0.052;
              if (p.life <= 0) { sps.splice(i, 1); continue; }
              const tail = p.len * p.life;
              bctx!.beginPath();
              bctx!.moveTo(p.x, p.y);
              bctx!.lineTo(p.x - Math.cos(p.a) * tail, p.y - Math.sin(p.a) * tail);
              bctx!.strokeStyle = `rgba(255,255,255,${p.life * 0.72})`;
              bctx!.lineWidth = p.life * 1.3;
              bctx!.lineCap = 'round';
              bctx!.stroke();
            }
          }
          braf = sps.length > 0 ? requestAnimationFrame(drawBurst) : null;
        }
        document.addEventListener('mousedown', (e) => spawnBurst(e.clientX, e.clientY));
      })();

      // ── Custom cursor ────────────────────────────────────────────
      ;(function () {
        if (!window.matchMedia('(pointer: fine)').matches) return;

        // Astro view transitions swap <body>, which recreates the cursor
        // elements and wipes the body's cursor-* classes. So these refs are
        // re-resolved (and state re-applied) on every swap, not cached once.
        let dot: HTMLElement | null = null;
        let ring: HTMLElement | null = null;
        let glow: HTMLElement | null = null;

        let mx = 0, my = 0, rx = 0, ry = 0, gx = 0, gy = 0;
        let glowScale = 1, glowTargetScale = 1;
        let entered = false, hovering = false;
        let clickTimer: ReturnType<typeof setTimeout> | null = null;

        function rebind() {
          dot = document.getElementById('cursor-dot');
          ring = document.getElementById('cursor-ring');
          glow = document.getElementById('cursor-glow');
          hovering = false;
          // The freshly swapped-in <body> lost its classes — if the pointer
          // is still in the window, restore the active state immediately so
          // the native cursor stays hidden and the custom one keeps its spot.
          if (entered) {
            document.body.classList.add('cursor-active');
            if (dot) dot.style.transform = `translate3d(${mx}px, ${my}px, 0)`;
            if (ring) ring.style.transform = `translate3d(${rx}px, ${ry}px, 0)`;
            if (glow) glow.style.transform = `translate3d(${gx}px, ${gy}px, 0) scale(${glowScale})`;
          }
        }
        rebind();
        document.addEventListener('astro:after-swap', rebind);

        document.addEventListener('mousemove', (e) => {
          mx = e.clientX; my = e.clientY;
          if (dot) dot.style.transform = `translate3d(${mx}px, ${my}px, 0)`;
          if (!entered) {
            entered = true;
            document.body.classList.add('cursor-active');
          }
        }, { passive: true });

        document.addEventListener('mouseleave', () => {
          entered = false;
          document.body.classList.remove('cursor-active');
        });

        document.addEventListener('mouseover', (e) => {
          const t = e.target as Element;
          const hoverable = t.closest(
            'a, button, summary, select, label, input, textarea, ' +
            '[role="button"], [role="link"], [role="tab"], .btn, [data-hover]'
          );
          const isHovering = !!hoverable;
          if (isHovering !== hovering) {
            hovering = isHovering;
            document.body.classList.toggle('cursor-hover', isHovering);
            glowTargetScale = isHovering ? 1.35 : 1;
          }
        }, { passive: true });

        document.addEventListener('mousedown', (e) => {
          if (clickTimer) clearTimeout(clickTimer);
          document.body.classList.add('cursor-click');
          glowTargetScale = 0.65;
          const ripple = document.getElementById('cursor-ripple');
          if (ripple) {
            ripple.style.setProperty('--ripple-pos', `translate(${e.clientX - 18}px, ${e.clientY - 18}px)`);
            ripple.classList.remove('fire');
            void ripple.offsetWidth;
            ripple.classList.add('fire');
          }
        });

        document.addEventListener('mouseup', () => {
          if (clickTimer) clearTimeout(clickTimer);
          clickTimer = setTimeout(() => {
            document.body.classList.remove('cursor-click');
            glowTargetScale = hovering ? 1.35 : 1;
          }, 120);
        });

        (function loop() {
          if (ring) {
            const dx = mx - rx, dy = my - ry;
            if (Math.abs(dx) + Math.abs(dy) > 0.05) {
              rx += dx * 0.09;
              ry += dy * 0.09;
              ring.style.transform = `translate3d(${rx}px, ${ry}px, 0)`;
            }
          }
          if (glow) {
            const dx = mx - gx, dy = my - gy, ds = glowTargetScale - glowScale;
            if (Math.abs(dx) + Math.abs(dy) > 0.05 || Math.abs(ds) > 0.002) {
              gx += dx * 0.055;
              gy += dy * 0.055;
              glowScale += ds * 0.08;
              glow.style.transform = `translate3d(${gx}px, ${gy}px, 0) scale(${glowScale})`;
            }
          }
          requestAnimationFrame(loop);
        })();
      })();
    </script>
  </body>
</html>
