---
import BackgroundShader from '../components/BackgroundShader.astro';
import '../styles/global.css';
import ClientRouter from 'astro/components/ClientRouter.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  keywords?: string;
}

const {
  title = 'Diverse Labs — AI Systems & Software Development',
  description = 'Diverse Labs builds custom AI agents, workflow automation, and production-grade software (web apps, mobile apps, desktop) for businesses that want to scale without adding headcount.',
  image = '/og-image.png',
  canonicalURL,
  keywords = 'AI agents, workflow automation, custom AI systems, web app development, mobile app development, AI chatbot, business automation, AI consulting, LLM integration',
} = Astro.props as Props;

const actualTitle = title;
const actualCanonicalURL = canonicalURL || Astro.url.href;
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "Diverse Labs",
  "alternateName": "Diverse Labs AI",
  "description": "Diverse Labs builds custom AI agents, workflow automation, and production-grade software for businesses. We specialize in AI-powered customer support, lead generation, product discovery, and end-to-end software development.",
  "url": "https://diverselabs.org",
  "email": "team@diverselabs.org",
  "sameAs": [
    "https://www.linkedin.com/company/diverse-labs-org"
  ],
  "areaServed": "Worldwide",
  "priceRange": "$$",
  "knowsAbout": [
    "Artificial Intelligence",
    "AI Agents",
    "Large Language Models",
    "Business Process Automation",
    "Workflow Automation",
    "Web Application Development",
    "Mobile Application Development",
    "Machine Learning",
    "CRM Integration",
    "Customer Support Automation",
    "Lead Generation Automation"
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "AI Systems & Software Development Services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "AI Customer Support Agents" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "AI Lead Generation Systems" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Intelligent Product Discovery" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Web Application Development" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Mobile App Development" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Custom Machine Learning Pipelines" } }
    ]
  }
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Diverse Labs",
  "url": "https://diverselabs.org",
  "description": "Custom AI systems and software development for businesses that compete to scale.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://diverselabs.org/?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Diverse Labs" />

    <!-- Open Graph -->
    <meta property="og:title" content={actualTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={actualCanonicalURL} />
    <meta property="og:site_name" content="Diverse Labs" />

    <!-- Twitter Card -->
    <meta name="twitter:title" content={actualTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.url)} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Canonical -->
    <link rel="canonical" href={actualCanonicalURL} />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <title>{actualTitle}</title>

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <!-- Astro View Transitions -->
    <ClientRouter />

    {gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){window.dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
  </head>
  <body>
    <!-- Custom cursor (desktop) -->
    <div class="cursor-glow" id="cursor-glow" aria-hidden="true"></div>
    <div class="cursor-dot" id="cursor-dot" aria-hidden="true"></div>
    <div class="cursor-ring" id="cursor-ring" aria-hidden="true"></div>
    <div class="cursor-ripple" id="cursor-ripple" aria-hidden="true"></div>

    <!-- Scroll progress indicator -->
    <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>

    <BackgroundShader />

    <!-- Navigation -->
    <div class="fixed top-0 left-0 right-0 z-50 px-3 pt-3 md:px-6 md:pt-6">
      <nav class="container max-w-7xl mx-auto backdrop-blur-xl bg-black/65 border border-white/8 rounded-full shadow-2xl shadow-black/30"
           aria-label="Main navigation">
        <div class="px-4 py-3 md:px-8 md:py-3.5 flex items-center justify-between gap-3">
          <a href="/" class="flex items-center gap-2 md:gap-2.5 text-base md:text-lg font-bold text-white hover:text-gray-200 transition-colors"
             aria-label="Diverse Labs home">
            <img src="/logo.svg" alt="Diverse Labs logo" class="w-7 h-7 md:w-7 md:h-7" />
            Diverse Labs
          </a>
          <ul class="hidden md:flex gap-7 items-center" role="list">
            <li><a href="/" class="text-sm text-text-secondary hover:text-white transition-colors">Home</a></li>
            <li><a href="/work" class="text-sm text-text-secondary hover:text-white transition-colors">Work</a></li>
            <li><a href="/about" class="text-sm text-text-secondary hover:text-white transition-colors">About</a></li>
            <li>
              <a href="https://cal.com/diverselabs/30min"
                 target="_blank"
                 rel="noopener noreferrer"
                 class="btn btn-primary text-sm py-2 px-5 rounded-full">
                Book a Call
              </a>
            </li>
          </ul>

          <details class="md:hidden relative">
            <summary class="nav-summary flex items-center justify-center w-9 h-9 rounded-full border border-white/12 bg-white/4 text-white cursor-pointer"
                     aria-label="Open menu">
              <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 7h16M4 12h16M4 17h16" />
              </svg>
            </summary>
            <div class="absolute right-0 mt-3 w-52 rounded-2xl border border-white/10 bg-black/95 backdrop-blur-xl p-3.5 shadow-2xl">
              <a href="/" class="block px-3 py-2.5 text-sm text-text-secondary hover:text-white rounded-lg hover:bg-white/4 transition-colors">Home</a>
              <a href="/work" class="block px-3 py-2.5 text-sm text-text-secondary hover:text-white rounded-lg hover:bg-white/4 transition-colors">Work</a>
              <a href="/about" class="block px-3 py-2.5 text-sm text-text-secondary hover:text-white rounded-lg hover:bg-white/4 transition-colors">About</a>
              <a href="https://cal.com/diverselabs/30min"
                 target="_blank"
                 rel="noopener noreferrer"
                 class="block mt-2 btn btn-primary text-sm py-2.5 px-4 text-center rounded-full">
                Book a Call
              </a>
            </div>
          </details>
        </div>
      </nav>
    </div>

    <!-- Main content slot -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-black/60 backdrop-blur-xl border-t border-white/6" role="contentinfo">
      <div class="container max-w-6xl mx-auto py-14 md:py-18">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 md:gap-12">
          <!-- Brand -->
          <div class="sm:col-span-2 lg:col-span-1">
            <a href="/" class="flex items-center gap-2 mb-4">
              <img src="/logo.svg" alt="Diverse Labs" class="w-6 h-6" />
              <span class="text-white font-bold">Diverse Labs</span>
            </a>
            <p class="text-text-secondary text-sm leading-relaxed mb-5 max-w-xs">Custom AI systems and production software for businesses that compete to scale.</p>
            <p class="text-text-tertiary text-xs tracking-wide">&copy; 2026 Diverse Labs. All rights reserved.</p>
          </div>

          <!-- Services -->
          <div>
            <h4 class="text-white font-semibold mb-4 text-sm tracking-wide">Services</h4>
            <ul class="space-y-3" role="list">
              <li><a href="/#capabilities" class="text-text-secondary hover:text-white transition-colors text-sm inline-block">AI Agents</a></li>
              <li><a href="/#software" class="text-text-secondary hover:text-white transition-colors text-sm inline-block">Software Development</a></li>
              <li><a href="/work" class="text-text-secondary hover:text-white transition-colors text-sm inline-block">Case Studies</a></li>
            </ul>
          </div>

          <!-- Company -->
          <div>
            <h4 class="text-white font-semibold mb-4 text-sm tracking-wide">Company</h4>
            <ul class="space-y-3" role="list">
              <li><a href="/about" class="text-text-secondary hover:text-white transition-colors text-sm inline-block">About</a></li>
              <li>
                <a href="https://cal.com/diverselabs/30min"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="text-text-secondary hover:text-white transition-colors text-sm inline-block">
                  Contact
                </a>
              </li>
              <li>
                <a href="https://www.linkedin.com/company/diverse-labs-org"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="text-text-secondary hover:text-white transition-colors text-sm inline-block">
                  LinkedIn
                </a>
              </li>
            </ul>
          </div>

          <!-- Get in Touch -->
          <div>
            <h4 class="text-white font-semibold mb-4 text-sm tracking-wide">Get in Touch</h4>
            <a href="mailto:team@diverselabs.org"
               class="text-text-secondary hover:text-white transition-colors text-sm block mb-2.5">
              team@diverselabs.org
            </a>
            <a href="https://cal.com/diverselabs/30min"
               target="_blank"
               rel="noopener noreferrer"
               class="inline-flex items-center gap-1.5 text-white hover:text-gray-300 transition-colors font-medium text-sm mt-3">
              Book a discovery call
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Scroll progress & reveal observer -->
    <script>
      // ── Smooth wheel scroll (momentum) ──────────────────────────
      ;(function () {
        if (!window.matchMedia('(pointer: fine)').matches) return;
        let ease = 0.1;
        let target = window.scrollY;
        let current = window.scrollY;
        let running = false;
        const getMax = () =>
          document.documentElement.scrollHeight - window.innerHeight;

        function isContainerScrollable(el: Element | null): boolean {
          while (el && el !== document.documentElement) {
            const s = getComputedStyle(el as HTMLElement);
            if (
              /auto|scroll/.test(s.overflow + s.overflowY) &&
              (el as HTMLElement).scrollHeight >
                (el as HTMLElement).clientHeight + 1
            )
              return true;
            el = (el as HTMLElement).parentElement;
          }
          return false;
        }

        function tick() {
          const diff = target - current;
          current += diff * ease;
          if (Math.abs(diff) > 0.5) {
            window.scrollTo(0, current);
            requestAnimationFrame(tick);
          } else {
            current = target;
            window.scrollTo(0, target);
            running = false;
          }
        }

        window.addEventListener(
          'wheel',
          (e) => {
            if (isContainerScrollable(e.target as Element)) return;
            e.preventDefault();
            if (!running) current = window.scrollY;
            let delta = e.deltaY;
            if (e.deltaMode === 1) delta *= 32;
            else if (e.deltaMode === 2) delta *= window.innerHeight * 0.8;
            target = Math.max(0, Math.min(target + delta * 0.85, getMax()));
            if (!running) {
              running = true;
              requestAnimationFrame(tick);
            }
          },
          { passive: false }
        );

        // Anchor-link smooth scroll handler (works with our intercepted wheel)
        document.addEventListener('click', (e) => {
          const link = (e.target as Element).closest('a[href^="#"]');
          if (!link) return;
          const href = link.getAttribute('href');
          const dest = href ? document.querySelector(href) : null;
          if (!dest) return;
          e.preventDefault();
          const rect = dest.getBoundingClientRect();
          target = Math.max(
            0,
            Math.min(window.scrollY + rect.top - 100, getMax())
          );
          current = window.scrollY;
          if (!running) {
            running = true;
            requestAnimationFrame(tick);
          }
        });

        document.addEventListener('astro:page-load', () => {
          target = window.scrollY;
          current = window.scrollY;
          running = false;
        });
      })();

      // ── Click burst particles (spark lines) ────────────────────
      ;(function () {
        if (!window.matchMedia('(pointer: fine)').matches) return;
        const bc = document.createElement('canvas');
        bc.style.cssText = 'position:fixed;inset:0;pointer-events:none;z-index:99997;';
        document.body.appendChild(bc);
        const bctx = bc.getContext('2d');
        if (!bctx) return;
        function resizeBC() { bc.width = window.innerWidth; bc.height = window.innerHeight; }
        resizeBC();
        window.addEventListener('resize', resizeBC, { passive: true });
        type SP = { x: number; y: number; vx: number; vy: number; life: number; len: number; a: number; kind: 'spark' | 'flash'; size: number; };
        const sps: SP[] = [];
        let braf: number | null = null;
        function spawnBurst(x: number, y: number) {
          // Radial flash that expands then fades
          sps.push({ x, y, vx: 0, vy: 0, life: 1, len: 0, a: 0, kind: 'flash', size: 0 });
          // Spark lines
          const n = 9;
          for (let i = 0; i < n; i++) {
            const a = (Math.PI * 2 / n) * i + (Math.random() - 0.5) * 0.45;
            const spd = Math.random() * 4.5 + 2;
            sps.push({ x, y, vx: Math.cos(a) * spd, vy: Math.sin(a) * spd,
              life: 1, len: Math.random() * 9 + 4, a, kind: 'spark', size: 0 });
          }
          if (!braf) braf = requestAnimationFrame(drawBurst);
        }
        function drawBurst() {
          bctx!.clearRect(0, 0, bc.width, bc.height);
          for (let i = sps.length - 1; i >= 0; i--) {
            const p = sps[i];
            if (p.kind === 'flash') {
              p.life -= 0.14;
              if (p.life <= 0) { sps.splice(i, 1); continue; }
              const r = 18 * (1 - p.life); // expands outward
              const grad = bctx!.createRadialGradient(p.x, p.y, 0, p.x, p.y, r);
              grad.addColorStop(0, `rgba(255,255,255,${p.life * 0.35})`);
              grad.addColorStop(1, 'rgba(255,255,255,0)');
              bctx!.beginPath();
              bctx!.arc(p.x, p.y, r, 0, Math.PI * 2);
              bctx!.fillStyle = grad;
              bctx!.fill();
            } else {
              p.x += p.vx; p.y += p.vy;
              p.vx *= 0.91; p.vy = p.vy * 0.91 + 0.09;
              p.life -= 0.052;
              if (p.life <= 0) { sps.splice(i, 1); continue; }
              const tail = p.len * p.life;
              bctx!.beginPath();
              bctx!.moveTo(p.x, p.y);
              bctx!.lineTo(p.x - Math.cos(p.a) * tail, p.y - Math.sin(p.a) * tail);
              bctx!.strokeStyle = `rgba(255,255,255,${p.life * 0.72})`;
              bctx!.lineWidth = p.life * 1.3;
              bctx!.lineCap = 'round';
              bctx!.stroke();
            }
          }
          braf = sps.length > 0 ? requestAnimationFrame(drawBurst) : null;
        }
        document.addEventListener('mousedown', (e) => spawnBurst(e.clientX, e.clientY));
      })();

      // ── Scroll progress bar ──────────────────────────────────────
      const progressBar = document.getElementById('scroll-progress');
      function updateProgress() {
        if (!progressBar) return;
        const scrolled = window.scrollY / (document.documentElement.scrollHeight - window.innerHeight);
        progressBar.style.width = `${Math.min(scrolled * 100, 100)}%`;
      }
      window.addEventListener('scroll', updateProgress, { passive: true });

      // ── Scroll reveal via IntersectionObserver ───────────────────
      function initReveal() {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
        );
        document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
      }

      // ── Number counter animation ─────────────────────────────────
      function initCounters() {
        document.querySelectorAll('[data-count]').forEach((el) => {
          const obs = new IntersectionObserver((entries) => {
            entries.forEach(e => {
              if (!e.isIntersecting) return;
              obs.unobserve(e.target);
              const target = parseFloat((el as HTMLElement).dataset.count || '0');
              const suffix = (el as HTMLElement).dataset.suffix || '';
              const duration = 1600;
              const startTime = performance.now();
              function easeOut(t: number) { return 1 - Math.pow(1 - t, 3); }
              function tick(now: number) {
                const progress = Math.min((now - startTime) / duration, 1);
                const val = easeOut(progress) * target;
                el.textContent = (Number.isInteger(target) ? Math.floor(val) : val.toFixed(1)) + suffix;
                if (progress < 1) requestAnimationFrame(tick);
              }
              requestAnimationFrame(tick);
            });
          }, { threshold: 0.6 });
          obs.observe(el);
        });
      }

      // ── Magnetic buttons ─────────────────────────────────────────
      function initMagnetic() {
        document.querySelectorAll<HTMLElement>('.magnetic').forEach(btn => {
          btn.addEventListener('mousemove', (e) => {
            const r = btn.getBoundingClientRect();
            const x = e.clientX - r.left - r.width / 2;
            const y = e.clientY - r.top - r.height / 2;
            btn.style.transform = `translate(${x * 0.25}px, ${y * 0.3}px)`;
            btn.style.transitionDuration = '0.12s';
          });
          btn.addEventListener('mouseleave', () => {
            btn.style.transform = 'translate(0, 0)';
            btn.style.transitionDuration = '0.5s';
          });
        });
      }

      // ── Custom cursor ────────────────────────────────────────────
      // Single IIFE — event listeners & rAF loop registered once.
      // Each handler queries the DOM directly so page transitions
      // (which swap body content) never leave stale element references.
      ;(function () {
        if (!window.matchMedia('(pointer: fine)').matches) return;

        let mx = 0, my = 0, rx = 0, ry = 0, gx = 0, gy = 0;
        let glowScale = 1, glowTargetScale = 1;
        let clickTimer: ReturnType<typeof setTimeout> | null = null;

        document.addEventListener('mousemove', (e) => {
          mx = e.clientX; my = e.clientY;
          const dot = document.getElementById('cursor-dot');
          if (dot) dot.style.transform = `translate(${mx}px, ${my}px)`;
          document.body.classList.add('cursor-active');
        }, { passive: true });

        document.addEventListener('mouseleave', () => {
          document.body.classList.remove('cursor-active');
        });

        // Universal hover detection — any interactive/clickable element
        document.addEventListener('mouseover', (e) => {
          const t = e.target as Element;
          const hoverable = t.closest(
            'a, button, summary, select, label, input[type="checkbox"], input[type="radio"], ' +
            '[role="button"], [role="link"], [role="tab"], [role="menuitem"], [role="option"], ' +
            '.btn, .service-header, .card-hover, details, [data-hover], .faq-item'
          );
          const isHovering = !!hoverable;
          document.body.classList.toggle('cursor-hover', isHovering);
          glowTargetScale = isHovering ? 1.35 : 1;
        }, { passive: true });

        document.addEventListener('mousedown', (e) => {
          if (clickTimer) clearTimeout(clickTimer);
          document.body.classList.add('cursor-click');
          glowTargetScale = 0.65;
          // Fire crosshair ripple from click origin
          const ripple = document.getElementById('cursor-ripple');
          if (ripple) {
            ripple.style.setProperty('--ripple-pos', `translate(${e.clientX - 18}px, ${e.clientY - 18}px)`);
            ripple.classList.remove('fire');
            void ripple.offsetWidth;
            ripple.classList.add('fire');
          }
        });

        document.addEventListener('mouseup', () => {
          if (clickTimer) clearTimeout(clickTimer);
          clickTimer = setTimeout(() => {
            document.body.classList.remove('cursor-click');
            glowTargetScale = document.body.classList.contains('cursor-hover') ? 1.35 : 1;
          }, 120);
        });

        (function loop() {
          // getElementById is O(1); querying each frame keeps refs fresh
          // after every Astro view-transition without any extra bookkeeping.
          const ring = document.getElementById('cursor-ring');
          const glow = document.getElementById('cursor-glow');
          // Ring follows with moderate lag
          if (ring) {
            rx += (mx - rx) * 0.09;
            ry += (my - ry) * 0.09;
            ring.style.transform = `translate(${rx}px, ${ry}px)`;
          }
          // Glow follows with slow lag + lerped scale
          if (glow) {
            gx += (mx - gx) * 0.055;
            gy += (my - gy) * 0.055;
            glowScale += (glowTargetScale - glowScale) * 0.08;
            glow.style.transform = `translate(${gx}px, ${gy}px) scale(${glowScale})`;
          }
          requestAnimationFrame(loop);
        })();
      })();

      // ── Init all on load ─────────────────────────────────────────
      function initAll() {
        initReveal();
        initCounters();
        initMagnetic();
        updateProgress();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAll);
      } else {
        initAll();
      }

      // Re-run on Astro page transitions
      document.addEventListener('astro:page-load', initAll);
    </script>
  </body>
</html>
