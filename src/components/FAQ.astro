---
export interface FAQItem {
  question: string;
  answer: string;
}

export interface Props {
  faqs: FAQItem[];
  includeSchema?: boolean;
}

const { faqs, includeSchema = true } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer,
    },
  })),
};
---

{includeSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}

<div
  class="space-y-2"
  itemscope
  itemtype="https://schema.org/FAQPage"
>
  {faqs.map((faq, i) => (
    <div
      class="faq-item surface-card rounded-xl overflow-hidden reveal"
      style={`transition-delay: ${i * 0.055}s`}
      itemscope
      itemprop="mainEntity"
      itemtype="https://schema.org/Question"
    >
      <details>
        <summary class="flex items-start justify-between gap-4 p-5 md:p-6 group select-none">
          <span
            class="text-white font-semibold text-base md:text-lg leading-snug"
            itemprop="name"
          >
            {faq.question}
          </span>
          <div class="faq-icon shrink-0 mt-0.5 w-7 h-7 rounded-full icon-surface flex items-center justify-center">
            <svg
              class="w-3.5 h-3.5 text-white/50"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <path d="M12 5v14M5 12h14" />
            </svg>
          </div>
        </summary>
        <div
          class="faq-answer px-5 md:px-6 pb-5 md:pb-6"
          itemscope
          itemprop="acceptedAnswer"
          itemtype="https://schema.org/Answer"
        >
          <p
            class="text-text-secondary leading-relaxed text-sm md:text-base"
            style="margin-bottom:0"
            itemprop="text"
          >
            {faq.answer}
          </p>
        </div>
      </details>
    </div>
  ))}
</div>

<style>
  .faq-item details[open] .faq-icon {
    transform: rotate(45deg);
    transition: transform 0.25s ease;
  }

  .faq-icon {
    transition: transform 0.25s ease;
  }
</style>
