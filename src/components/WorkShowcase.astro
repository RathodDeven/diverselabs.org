---

<!-- Hero -->
<section class="page-section-tight" style="padding-top: clamp(8rem, 16vh, 11rem)">
  <div class="container">
    <p class="label mb-6" data-reveal>Selected projects</p>
    <h1 class="display-hero" data-split style="font-size: clamp(2.8rem, 7.5vw, 6.5rem)">
      Production work.<br /><span class="text-outline">Real results.</span>
    </h1>
    <div class="mt-8 flex flex-col md:flex-row md:items-end md:justify-between gap-6" data-reveal data-reveal-delay="0.35">
      <p class="hero-sub">
        Everything here is live, in production, and solving real problems.
      </p>

      <div class="work-tabs" role="tablist" aria-label="Work categories">
        <a
          class={`work-tab-btn${isAllActive ? ' active' : ''}`}
          role="tab"
          aria-selected={String(isAllActive)}
          href="/work"
          data-work-tab="all"
        >
          All Projects
        </a>
        <a
          class={`work-tab-btn${isAiCreativesActive ? ' active' : ''}`}
          role="tab"
          aria-selected={String(isAiCreativesActive)}
          href="/work/ai-creatives"
          data-work-tab="ai-creatives"
        >
          AI Creatives
        </a>
      </div>
    </div>
  </div>
</section>

<section
  class="page-section work-panel"
  data-work-panel="all"
  hidden={!isAllActive}
>
    <div class="container">
      <div class="proj-list">
        {projects.map((project, i) => (
          <article class="proj-row" data-reveal>
            <a
              href={project.website}
              target={project.website.startsWith('http') ? '_blank' : undefined}
              rel={project.website.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="proj-media"
              data-parallax
              data-parallax-speed="6"
              aria-label={`${project.ctaLabel} — ${project.name}`}
            >
              <img
                src={project.image}
                alt={`${project.name} project screenshot`}
                width="1280"
                height="720"
                loading={i < 2 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <span class="proj-visit">{project.ctaLabel} <span aria-hidden="true">↗</span></span>
            </a>
            <div class="proj-meta">
              <span class="proj-idx mono-num">{String(i + 1).padStart(2, '0')} — {project.client}</span>
              <h3>
                <a
                  href={project.website}
                  target={project.website.startsWith('http') ? '_blank' : undefined}
                  rel={project.website.startsWith('http') ? 'noopener noreferrer' : undefined}
                >{project.name}</a>
              </h3>
              <p>{project.description}</p>
              <div class="proj-tags">
                {project.tags.map((tag) => <span class="chip">{tag}</span>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
</section>

<section
  class="page-section-tight work-panel"
  data-work-panel="ai-creatives"
  hidden={!isAiCreativesActive}
>
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="label mb-4">AI video & UGC</p>
          <h2>AI-generated creatives</h2>
        </div>
        <span class="head-side">Avatars · Voice · Brand</span>
      </div>

      <div class="ai-video-grid" data-reveal-group>
        {aiVideos.map((v) => (
          <div class="ai-video-card">
            <div class="ai-video-embed">
              <iframe
                src={`https://www.youtube.com/embed/${v.id}?rel=0&playsinline=1`}
                title={v.label}
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
            <div class="ai-video-label">{v.label}</div>
          </div>
        ))}
      </div>

      <div class="ai-pricing" data-reveal>
        <div>
          <h3>Let's chat about pricing for your brand.</h3>
          <p>Tell us what you're selling — we'll come back with creative directions and a price.</p>
        </div>
        <a href={aiPricingMail} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg magnetic">
          Chat about pricing
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
</section>

<script>
  // Tab switching swaps panels in place — no page navigation, no re-render
  function initWorkTabs() {
    const tabs = document.querySelectorAll<HTMLAnchorElement>('[data-work-tab]');
    const panels = document.querySelectorAll<HTMLElement>('[data-work-panel]');
    if (!tabs.length || !panels.length) return;

    const titles: Record<string, string> = {
      all: 'Our Work | Diverse Labs: AI Systems & Products in Production',
      'ai-creatives': 'AI Creatives | Diverse Labs: AI-Generated Ads & UGC Videos',
    };

    const activate = (key: string) => {
      tabs.forEach((tab) => {
        const on = tab.dataset.workTab === key;
        tab.classList.toggle('active', on);
        tab.setAttribute('aria-selected', String(on));
      });
      panels.forEach((panel) => {
        const on = panel.dataset.workPanel === key;
        if (on && panel.hidden) {
          panel.hidden = false;
          // Reveal animations may have initialized while hidden — force visible
          panel
            .querySelectorAll<HTMLElement>('[data-reveal], [data-reveal-group] > *')
            .forEach((el) => {
              el.style.opacity = '1';
              el.style.transform = 'none';
            });
          panel.classList.remove('panel-in');
          void panel.offsetWidth;
          panel.classList.add('panel-in');
        } else if (!on) {
          panel.hidden = true;
        }
      });
      if (titles[key]) document.title = titles[key];
      // Layout changed under pinned/scrubbed sections — let ScrollTrigger re-measure
      window.dispatchEvent(new Event('resize'));
    };

    tabs.forEach((tab) => {
      if (tab.dataset.bound) return;
      tab.dataset.bound = 'true';
      tab.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();
        const key = tab.dataset.workTab!;
        activate(key);
        // Keep the URL shareable without creating history entries or
        // disturbing Astro's router state
        history.replaceState(history.state, '', tab.href);
      });
    });
  }

  document.addEventListener('astro:page-load', initWorkTabs);
  if (document.readyState !== 'loading') initWorkTabs();
  else document.addEventListener('DOMContentLoaded', initWorkTabs);
</script>

<!-- CTA -->
<section class="page-section-tight pb-24">
  <div class="container">
    <div class="cta-panel" data-reveal>
      <div class="relative z-10">
        <h2 class="cta-title">Your project could be next.</h2>
        <p class="cta-sub">Let's talk about what we can build and automate for you.</p>
        <a href="https://cal.com/diverselabs/30min" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg magnetic">
          Schedule a Discovery Call
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>
