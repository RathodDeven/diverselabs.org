---
interface Props {
  activeTab?: 'all' | 'ai-creatives';
}

const { activeTab = 'all' } = Astro.props as Props;
const isAllActive = activeTab === 'all';
const isAiCreativesActive = activeTab === 'ai-creatives';

const projects = [
  {
    name: 'NudgeFlow',
    client: 'ClickPe · YC S23',
    website: 'https://drive.google.com/file/d/10uMQ51a0u_D_SWAobehndmie-6HTT-lZ/view',
    image: '/work/nudgeflow.webp',
    description:
      'WhatsApp chatbot and voice call agent that classifies leads, triggers follow-ups, retries dropped journeys, and syncs outcomes to workflow systems.',
    tags: ['AI system', 'Voice agent', 'WhatsApp'],
    ctaLabel: 'Watch demo',
  },
  {
    name: 'BloomersTV',
    client: 'Creator platform',
    website: 'https://bloomers.tv/',
    image: '/work/bloomerstv.webp',
    description:
      'A live streaming platform built around the Lens ecosystem — creator-focused, community-driven, and production quality.',
    tags: ['Web app', 'Blockchain', 'Streaming'],
    ctaLabel: 'Visit site',
  },
  {
    name: 'Paiso',
    client: 'Consumer fintech',
    website: 'https://paiso.xyz/',
    image: '/work/paiso.webp',
    description:
      'A consumer fintech app live on the Play Store, centered on fast cash access and rewards for everyday users.',
    tags: ['Mobile app', 'Fintech'],
    ctaLabel: 'Visit site',
  },
  {
    name: 'DANZ NOW',
    client: 'Move. Connect. Earn.',
    website: 'https://danz.now/',
    image: '/work/danz-now.webp',
    description:
      'A movement and event platform rewarding users for dancing, hosting events, and joining community experiences.',
    tags: ['Mobile app', 'Community'],
    ctaLabel: 'Visit site',
  },
  {
    name: 'Hand Protocol',
    client: 'Public goods',
    website: 'https://handprotocol.org/',
    image: '/work/hand-protocol.webp',
    description:
      'A platform connecting public goods projects with donors through a streamlined digital contribution experience.',
    tags: ['Web app', 'Blockchain'],
    ctaLabel: 'Visit site',
  },
];

const aiVideos = [
  { id: '4Ekp3bFrF1M', label: 'Aguanea Can Showcase | AD Creative' },
  { id: 'SWuk4UW41gw', label: 'Fendi Boots AI Timelapse | AD Creative' },
  { id: 't_nK3JmUjNk', label: 'UGC Content with SFX and Overlay' },
  { id: 'zHxz5vNCBkQ', label: 'YSL | Luxury Product Showcase' },
  { id: 'ChPllafoxew', label: 'Katmaconie Heels AD Reel UGC' },
];
---

<!-- Hero -->
<section class="page-section-tight" style="padding-top: clamp(8rem, 16vh, 11rem)">
  <div class="container">
    <p class="label mb-6" data-reveal>Selected projects</p>
    <h1 class="display-hero" data-split style="font-size: clamp(2.8rem, 7.5vw, 6.5rem)">
      Production work.<br /><span class="text-outline">Real results.</span>
    </h1>
    <div class="mt-8 flex flex-col md:flex-row md:items-end md:justify-between gap-6" data-reveal data-reveal-delay="0.35">
      <p class="hero-sub">
        Everything here is live, in production, and solving real problems.
      </p>

      <div class="work-tabs" role="tablist" aria-label="Work categories">
        <a
          class={`work-tab-btn${isAllActive ? ' active' : ''}`}
          role="tab"
          aria-selected={String(isAllActive)}
          href="/work"
        >
          All Projects
        </a>
        <a
          class={`work-tab-btn${isAiCreativesActive ? ' active' : ''}`}
          role="tab"
          aria-selected={String(isAiCreativesActive)}
          href="/work/ai-creatives"
        >
          AI Creatives
        </a>
      </div>
    </div>
  </div>
</section>

{isAllActive && (
  <section class="page-section">
    <div class="container">
      <div class="proj-list">
        {projects.map((project, i) => (
          <article class="proj-row" data-reveal>
            <a
              href={project.website}
              target="_blank"
              rel="noopener noreferrer"
              class="proj-media"
              data-parallax
              data-parallax-speed="6"
              aria-label={`${project.ctaLabel} — ${project.name}`}
            >
              <img
                src={project.image}
                alt={`${project.name} project screenshot`}
                width="1280"
                height="720"
                loading={i < 2 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <span class="proj-visit">{project.ctaLabel} <span aria-hidden="true">↗</span></span>
            </a>
            <div class="proj-meta">
              <span class="proj-idx mono-num">{String(i + 1).padStart(2, '0')} — {project.client}</span>
              <h3>
                <a href={project.website} target="_blank" rel="noopener noreferrer">{project.name}</a>
              </h3>
              <p>{project.description}</p>
              <div class="proj-tags">
                {project.tags.map((tag) => <span class="chip">{tag}</span>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

{isAiCreativesActive && (
  <section class="page-section-tight">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="label mb-4">AI video & UGC</p>
          <h2>AI-generated creatives</h2>
        </div>
        <span class="head-side">Avatars · Voice · Brand</span>
      </div>

      <div class="ai-video-grid" data-reveal-group>
        {aiVideos.map((v) => (
          <div class="ai-video-card">
            <div class="ai-video-embed">
              <iframe
                src={`https://www.youtube.com/embed/${v.id}?rel=0&playsinline=1`}
                title={v.label}
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
            <div class="ai-video-label">{v.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<!-- CTA -->
<section class="page-section-tight pb-24">
  <div class="container">
    <div class="cta-panel" data-reveal>
      <div class="relative z-10">
        <h2 class="cta-title">Your project could be next.</h2>
        <p class="cta-sub">Let's talk about what we can build and automate for you.</p>
        <a href="https://cal.com/diverselabs/30min" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg magnetic">
          Schedule a Discovery Call
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>
