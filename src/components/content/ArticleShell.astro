---
import type { Doc } from '../../data/content';
import { TYPE_LABELS } from '../../data/content';
import Breadcrumb from './Breadcrumb.astro';
import ContentBlocks from './ContentBlocks.astro';
import Faq from '../Faq.astro';
import CTAButton from '../CTAButton.astro';

interface Props {
  doc: Doc;
  crumbs: { name: string; href: string }[];
  /** Optional decorative cover/illustration rendered under the hero */
  cover?: string;
  /** Optional per-stage diagrams rendered as a "How it progressed" gallery */
  stages?: { label: string; src: string }[];
  /** Override the closing CTA (label + href). Defaults to the cal.com booking link. */
  ctaLabel?: string;
  ctaHref?: string;
  /** Enable the local (dev-only) per-section hide + inline editor for this doc. */
  editable?: boolean;
}
const { doc, crumbs, cover, stages, ctaLabel, ctaHref, editable } = Astro.props as Props;
const EDIT = import.meta.env.DEV && !!editable;
const finalCtaHref = ctaHref ?? 'https://cal.com/diverselabs/30min';
const finalCtaLabel = ctaLabel ?? 'Book a Discovery Call';

// ── At-a-glance: auto-derive 3 scannable bullets from the existing blocks ──
// Goal: a 7-second reader gets the gist without scrolling into long prose.
// Picks the first available source in priority order: a metrics strip (counts
// from the source), a callouts panel (titles), a steps panel (titles), a stack
// (group labels), a split (after-state points). Always exactly 3 items.
function deriveScanPoints(blocks: typeof doc.blocks): { kicker: string; text: string }[] {
  const m = blocks.find((b) => b.kind === 'metrics') as Extract<typeof blocks[number], { kind: 'metrics' }> | undefined;
  if (m && m.items.length) return m.items.slice(0, 3).map((it) => ({ kicker: it.value, text: it.label }));
  const c = blocks.find((b) => b.kind === 'callouts') as Extract<typeof blocks[number], { kind: 'callouts' }> | undefined;
  if (c && c.items.length) return c.items.slice(0, 3).map((it) => ({ kicker: '·', text: it.title }));
  const sp = blocks.find((b) => b.kind === 'steps') as Extract<typeof blocks[number], { kind: 'steps' }> | undefined;
  if (sp && sp.items.length) return sp.items.slice(0, 3).map((it, i) => ({ kicker: String(i + 1).padStart(2, '0'), text: it.title }));
  const st = blocks.find((b) => b.kind === 'stack') as Extract<typeof blocks[number], { kind: 'stack' }> | undefined;
  if (st && st.groups.length) return st.groups.slice(0, 3).map((g, i) => ({ kicker: String(i + 1).padStart(2, '0'), text: g.label }));
  const sl = blocks.find((b) => b.kind === 'split') as Extract<typeof blocks[number], { kind: 'split' }> | undefined;
  if (sl && sl.after?.points?.length) return sl.after.points.slice(0, 3).map((p) => ({ kicker: '→', text: p.replace(/<[^>]+>/g, '') }));
  return [];
}
const scan = deriveScanPoints(doc.blocks);
const hasStages = stages && stages.length > 0;
const hasFaq = doc.faq && doc.faq.length > 0;
const hasRelated = doc.related && doc.related.length > 0;
// Approx read-time from total prose length (rough but useful signal).
const wordCount = doc.blocks.reduce((n, b) => {
  if (b.kind === 'prose') return n + b.body.split(/\s+/).length;
  if (b.kind === 'callouts') return n + b.items.reduce((m, it) => m + it.body.split(/\s+/).length, 0);
  if (b.kind === 'steps') return n + b.items.reduce((m, it) => m + it.body.split(/\s+/).length, 0);
  return n;
}, 0);
const readMin = Math.max(2, Math.round(wordCount / 220));
---

<article class="doc">
  <header class="doc-hero">
    <div class="container container-narrow">
      <Breadcrumb crumbs={crumbs} />

      <div class="doc-eyebrow" data-reveal>
        <span class="label no-rule">{doc.eyebrow}</span>
        <span class="doc-type mono-num">{TYPE_LABELS[doc.type] ?? 'Article'}</span>
      </div>

      {doc.directlyDelivered && (
        <div class="doc-delivered" data-reveal data-reveal-delay="0.1">
          <span class="doc-delivered-mark" aria-hidden="true">✓</span>
          Directly delivered
        </div>
      )}

      <h1 class="doc-title" data-split>{doc.title}</h1>
      <p class="doc-dek" data-reveal data-reveal-delay="0.2">{doc.dek}</p>

      <div class="doc-meta" data-reveal data-reveal-delay="0.3">
        {doc.client && (
          <span class="doc-client">
            {doc.clientLogo && <img src={doc.clientLogo} alt={`${doc.client} logo`} width="22" height="22" loading="lazy" />}
            {doc.client}
          </span>
        )}
        {doc.timeframe && <span class="doc-when mono-num">{doc.timeframe}</span>}
        <div class="doc-tags">
          {doc.tags.map((t) => <span class="chip">{t}</span>)}
        </div>
      </div>

      {doc.heroStat && (
        <div class="doc-herostat" data-reveal data-reveal-delay="0.4">
          <span class="doc-herostat-val">{doc.heroStat.value}</span>
          <span class="doc-herostat-lab">{doc.heroStat.label}</span>
        </div>
      )}

      {cover && (
        <div class="doc-cover" data-reveal data-reveal-delay="0.5">
          <img src={cover} alt="" loading="lazy" width="640" height="400" />
        </div>
      )}
    </div>
  </header>

  <div class="container container-narrow">
    <!-- ── At a glance ── for the 7-second reader ─────────────────────── -->
    {scan.length > 0 && (
      <section class="doc-scan" data-reveal>
        <div class="doc-scan-head">
          <span class="doc-scan-eyebrow">At a glance</span>
          <span class="doc-scan-time mono-num">{readMin} min read · {doc.blocks.length} sections{hasStages ? ` · ${stages!.length} diagrams` : ''}</span>
        </div>
        <ul class="doc-scan-list">
          {scan.map((p) => (
            <li class="doc-scan-item">
              <span class="doc-scan-kicker">{p.kicker}</span>
              <span class="doc-scan-text">{p.text}</span>
            </li>
          ))}
        </ul>
        <nav class="doc-scan-jump" aria-label="Jump to section">
          <span class="doc-scan-jump-label">Jump to</span>
          {hasStages && <a href="#how-it-progressed">Stages</a>}
          {hasFaq && <a href="#faq">FAQ</a>}
          {hasRelated && <a href="#related">Related</a>}
          <a href="#cta">Contact</a>
        </nav>
      </section>
    )}

    {doc.contribution && (
      <section class="doc-contrib" data-reveal id="my-contribution">
        <div class="doc-contrib-head">
          <span class="doc-contrib-mark" aria-hidden="true">✓</span>
          <span class="doc-contrib-eyebrow">Direct contribution</span>
        </div>
        <p class="doc-contrib-body" set:html={doc.contribution} />
      </section>
    )}

    <ContentBlocks blocks={doc.blocks} slug={EDIT ? doc.slug : ''} />

    {stages && stages.length > 0 && (
      <section class="db db-stages" data-reveal id="how-it-progressed">
        <h2>How it progressed</h2>
        <div class="stage-track" data-reveal-group>
          {stages.map((s, i) => (
            <figure class="stage-fig">
              <div class="stage-img"><img src={s.src} alt={s.label} loading="lazy" width="640" height="400" /></div>
              <figcaption><span class="mono-num">{String(i + 1).padStart(2, '0')}</span> {s.label}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    {doc.faq && doc.faq.length > 0 && (
      <section class="db db-faq" data-reveal id="faq">
        <h2>Frequently asked</h2>
        <Faq items={doc.faq} />
      </section>
    )}

    {doc.related && doc.related.length > 0 && (
      <section class="db db-related" data-reveal id="related">
        <h2>Keep reading</h2>
        <div class="related-grid" data-reveal-group>
          {doc.related.map((r) => (
            <a class="related-card" href={r.href}>
              {r.eyebrow && <span class="related-eyebrow mono-num">{r.eyebrow}</span>}
              <span class="related-label">{r.label}</span>
              <span class="related-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="db db-cta" data-reveal id="cta">
      <div class="doc-cta">
        <h2>{doc.cta?.title ?? 'Want this for your team?'}</h2>
        <p>{doc.cta?.sub ?? "Tell us the workflow. We'll show you what to automate first, and what it's worth."}</p>
        <CTAButton href={finalCtaHref}>{finalCtaLabel}</CTAButton>
      </div>
    </section>
  </div>
</article>

{EDIT && (
  <div class="pf-edit-hint" aria-hidden="true">
    <span class="pf-edit-dot"></span>
    Local edit mode · click text to edit · hover a section to hide
  </div>
)}

{EDIT && (
  <script>
    // Local editor (dev only). Persists section hide + inline text edits to
    // src/data/portfolio.local.json via the /__pf-local dev middleware. Stripped
    // from production (gated by import.meta.env.DEV at the markup + here).
    if (import.meta.env.DEV) {
      const post = (payload: Record<string, unknown>) =>
        fetch('/__pf-local', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });

      const bind = () => {
        const root = document.querySelector<HTMLElement>('.doc-blocks');
        if (!root || root.dataset.editorBound) return;
        root.dataset.editorBound = 'true';
        const slug = root.getAttribute('data-slug') || '';

        // Section hide / unhide
        root.querySelectorAll<HTMLButtonElement>('.sec-hide').forEach((btn) => {
          btn.addEventListener('click', async (e) => {
            e.preventDefault();
            const sec = btn.closest<HTMLElement>('.db');
            if (!sec) return;
            const index = Number(sec.getAttribute('data-bi'));
            const willHide = !sec.classList.contains('is-section-hidden');
            sec.classList.toggle('is-section-hidden', willHide);
            btn.textContent = willHide ? 'Unhide section' : 'Hide section';
            const tools = sec.querySelector('.sec-tools');
            let badge = sec.querySelector('.sec-badge');
            if (willHide && !badge && tools) {
              badge = document.createElement('span');
              badge.className = 'sec-badge';
              badge.textContent = 'Hidden from live';
              tools.prepend(badge);
            } else if (!willHide && badge) {
              badge.remove();
            }
            await post({ slug, index, op: 'hide' });
          });
        });

        // Inline text edits
        root.querySelectorAll<HTMLElement>('[data-e]').forEach((el) => {
          const isHtml = el.hasAttribute('data-html');
          if (!isHtml) {
            el.addEventListener('keydown', (e) => {
              if (e.key === 'Enter') { e.preventDefault(); el.blur(); }
            });
          }
          el.addEventListener('focus', () => {
            el.dataset.orig = isHtml ? el.innerHTML : (el.innerText || '');
          });
          el.addEventListener('blur', async () => {
            const value = (isHtml ? el.innerHTML : (el.innerText || '')).trim();
            if (value === (el.dataset.orig || '').trim()) return; // unchanged
            const sec = el.closest<HTMLElement>('.db');
            if (!sec) return;
            const index = Number(sec.getAttribute('data-bi'));
            const path = el.getAttribute('data-e');
            try {
              await post({ slug, index, op: 'edit', path, value });
              el.classList.add('e-saved');
              setTimeout(() => el.classList.remove('e-saved'), 900);
            } catch {
              el.classList.add('e-error');
            }
          });
        });
      };
      bind();
      document.addEventListener('astro:page-load', bind);
    }
  </script>
)}

<style>
  .pf-edit-hint {
    position: fixed;
    top: clamp(0.6rem, 2vw, 1rem);
    right: clamp(0.6rem, 2vw, 1rem);
    z-index: 80;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.45rem 0.7rem;
    border: 1px solid rgba(120, 170, 255, 0.4);
    border-radius: 0.6rem;
    background: rgba(12, 12, 12, 0.82);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: var(--muted);
    pointer-events: none;
  }
  .pf-edit-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: rgba(120, 170, 255, 0.9);
    box-shadow: 0 0 8px rgba(120, 170, 255, 0.7);
  }

  /* ── "Directly delivered by me" badge + contribution panel ── */
  .doc-delivered {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0.9rem 0 0.1rem;
    padding: 0.38rem 0.85rem 0.38rem 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 2rem;
    background: rgba(255, 255, 255, 0.06);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .doc-delivered-mark,
  .doc-contrib-mark {
    display: inline-grid;
    place-items: center;
    border-radius: 50%;
    background: #fff;
    color: #0a0a0a;
    line-height: 1;
  }
  .doc-delivered-mark { width: 16px; height: 16px; font-size: 0.58rem; }
  .doc-contrib {
    margin: 0 0 clamp(1.75rem, 3.5vw, 2.5rem);
    border: 1px solid var(--line);
    border-left: 2px solid rgba(255, 255, 255, 0.55);
    border-radius: 0.9rem;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0));
    padding: clamp(1.1rem, 2vw, 1.5rem) clamp(1.2rem, 2.2vw, 1.7rem);
  }
  .doc-contrib-head {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 0.65rem;
  }
  .doc-contrib-mark { width: 18px; height: 18px; font-size: 0.66rem; }
  .doc-contrib-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .doc-contrib-body {
    margin: 0;
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--muted);
  }
  .doc-contrib-body :global(strong) { color: var(--ink); font-weight: 600; }

  /* ── At a glance (front-loaded scan panel for the 7-second reader) ── */
  .doc-scan {
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 clamp(1.75rem, 3.5vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0));
    padding: clamp(1.1rem, 2vw, 1.5rem) clamp(1.2rem, 2.2vw, 1.7rem);
  }
  .doc-scan-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--line);
  }
  .doc-scan-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .doc-scan-time {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .doc-scan-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.7rem;
  }
  @media (min-width: 720px) {
    .doc-scan-list { grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  }
  .doc-scan-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.65rem 0.7rem;
    border-left: 2px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.025);
    border-radius: 0 0.45rem 0.45rem 0;
  }
  .doc-scan-kicker {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.1;
  }
  .doc-scan-text {
    font-size: 0.86rem;
    color: var(--muted);
    line-height: 1.45;
  }
  .doc-scan-jump {
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .doc-scan-jump-label { color: var(--faint); }
  .doc-scan-jump a {
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .doc-scan-jump a:hover {
    color: var(--ink);
    border-bottom-color: rgba(255, 255, 255, 0.4);
  }
  /* smooth scroll for in-page anchors */
  html { scroll-behavior: smooth; }
  [id] { scroll-margin-top: 1.5rem; }

  .doc-when {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
    align-self: center;
  }
  .doc-cover {
    margin-top: clamp(2rem, 4vw, 3rem);
    border: 1px solid var(--line);
    border-radius: 1rem;
    overflow: hidden;
    background: #0a0a0a;
  }
  .doc-cover img { display: block; width: 100%; height: auto; }

  .db-stages h2 { margin-bottom: 1.5rem; }
  .stage-track { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 720px) { .stage-track { grid-template-columns: repeat(3, 1fr); } }
  .stage-fig { margin: 0; }
  .stage-img {
    border: 1px solid var(--line);
    border-radius: 0.8rem;
    overflow: hidden;
    background: #0a0a0a;
    transition: border-color 0.35s ease;
  }
  .stage-fig:hover .stage-img { border-color: rgba(255, 255, 255, 0.22); }
  .stage-img img { display: block; width: 100%; height: auto; }
  .stage-fig figcaption {
    margin-top: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .stage-fig figcaption .mono-num { color: var(--faint); }
</style>
