---
import type { Doc } from '../../data/content';
import Breadcrumb from './Breadcrumb.astro';
import ContentBlocks from './ContentBlocks.astro';

interface Props {
  doc: Doc;
  crumbs: { name: string; href: string }[];
}
const { doc, crumbs } = Astro.props as Props;
const typeLabel: Record<string, string> = {
  'case-study': 'Case study',
  tutorial: 'Tutorial',
  comparison: 'Comparison',
  pillar: 'Guide',
  guide: 'Guide',
};
---

<article class="doc">
  <header class="doc-hero">
    <div class="container container-narrow">
      <Breadcrumb crumbs={crumbs} />

      <div class="doc-eyebrow" data-reveal>
        <span class="label no-rule">{doc.eyebrow}</span>
        <span class="doc-type mono-num">{typeLabel[doc.type] ?? 'Article'}</span>
      </div>

      <h1 class="doc-title" data-split>{doc.title}</h1>
      <p class="doc-dek" data-reveal data-reveal-delay="0.2">{doc.dek}</p>

      <div class="doc-meta" data-reveal data-reveal-delay="0.3">
        {doc.client && (
          <span class="doc-client">
            {doc.clientLogo && <img src={doc.clientLogo} alt={`${doc.client} logo`} width="22" height="22" loading="lazy" />}
            {doc.client}
          </span>
        )}
        <div class="doc-tags">
          {doc.tags.map((t) => <span class="chip">{t}</span>)}
        </div>
      </div>

      {doc.heroStat && (
        <div class="doc-herostat" data-reveal data-reveal-delay="0.4">
          <span class="doc-herostat-val">{doc.heroStat.value}</span>
          <span class="doc-herostat-lab">{doc.heroStat.label}</span>
        </div>
      )}
    </div>
  </header>

  <div class="container container-narrow">
    <ContentBlocks blocks={doc.blocks} />

    {doc.faq && doc.faq.length > 0 && (
      <section class="db db-faq" data-reveal>
        <h2>Frequently asked</h2>
        <div class="faq-list acc-group">
          {doc.faq.map((f, i) => (
            <div class={`faq-item acc-item${i === 0 ? ' open' : ''}`}>
              <button class="faq-head acc-head" aria-expanded={i === 0 ? 'true' : 'false'}>
                <span class="faq-idx mono-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="faq-q">{f.q}</span>
                <span class="faq-icon" aria-hidden="true">+</span>
              </button>
              <div class="faq-body">
                <div class="faq-body-inner"><p>{f.a}</p></div>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    {doc.related && doc.related.length > 0 && (
      <section class="db db-related" data-reveal>
        <h2>Keep reading</h2>
        <div class="related-grid" data-reveal-group>
          {doc.related.map((r) => (
            <a class="related-card" href={r.href}>
              {r.eyebrow && <span class="related-eyebrow mono-num">{r.eyebrow}</span>}
              <span class="related-label">{r.label}</span>
              <span class="related-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="db db-cta" data-reveal>
      <div class="doc-cta">
        <h2>{doc.cta?.title ?? 'Want this for your team?'}</h2>
        <p>{doc.cta?.sub ?? "Tell us the workflow. We'll show you what to automate first — and what it's worth."}</p>
        <a href="https://cal.com/diverselabs/30min" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg magnetic">
          Book a Discovery Call
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </div>
</article>
