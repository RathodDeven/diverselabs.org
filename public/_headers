# Default: HTML and everything unmatched below — always revalidate.
# HTML must never be cached with a TTL: it references hashed asset names
# that are purged on each deploy, so stale HTML = broken (static) site.
/*
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Hashed build output (JS/CSS) — filenames change on every content change,
# safe to cache forever
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Unhashed media directories — replaced in place occasionally, refresh daily
/work/*
  ! Cache-Control
  Cache-Control: public, max-age=86400

/people/*
  ! Cache-Control
  Cache-Control: public, max-age=86400

/companies/*
  ! Cache-Control
  Cache-Control: public, max-age=86400
